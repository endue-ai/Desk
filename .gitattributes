# LF everywhere, so formatters and generated-file checks agree on every OS (Windows CI included).
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.svg text eol=lf

# Third-party code copied in by `just vendor-terminal` (ADR 0037): not ours, not worth a diff.
plugins/*/ui/vendor/** linguist-vendored -diff
