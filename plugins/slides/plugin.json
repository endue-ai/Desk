{
  "id": "endue.slides",
  "name": "Slides",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens PowerPoint, OpenDocument and older PowerPoint presentations in one viewer with a thumbnail rail, speaker notes and play mode; shows Keynote previews and Google Slides shortcuts. Read-only.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "shell:open",
      "schemes": ["http", "https", "mailto"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Slides",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.pptx",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.pptm",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.ppsx",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.ppsm",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.potx",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.potm",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.ppt",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.pps",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.pot",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.odp",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.otp",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.fodp",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.key",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.gslides",
        "plugin": "endue.slides"
      }
    ],
    "commands": [
      {
        "id": "endue.slides.read",
        "title": "Slides: the open deck as text",
        "keywords": [
          "slides",
          "deck",
          "presentation",
          "powerpoint",
          "pptx",
          "keynote",
          "read",
          "notes"
        ],
        "description": "The deck on screen in Slides, or the open one named by path, slide by slide: each with its number, title, whether it is hidden, the text of its shapes and tables in drawing order (bullets marked, table rows with | between cells) and its speaker notes. count slides from from (1 is the first; 20 by default, at most 200); total and more say how many there are. decks lists every deck Slides has open. It leaves the screen as it is. Slides reads only what the desk opened in it: open a file with desk.files.open first.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "from": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "total": {
              "type": "integer"
            },
            "slides": {
              "type": ["array", "null"]
            },
            "more": {
              "type": "boolean"
            },
            "decks": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
