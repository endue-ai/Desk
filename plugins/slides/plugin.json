{
  "id": "endue.slides",
  "name": "Slides",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens PowerPoint, OpenDocument and older PowerPoint presentations in one viewer with a thumbnail rail, speaker notes and play mode; shows Keynote previews and Google Slides shortcuts. Read-only.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "shell:open",
      "schemes": ["http", "https", "mailto"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Slides",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.pptx",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.pptm",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.ppsx",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.ppsm",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.potx",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.potm",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.ppt",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.pps",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.pot",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.odp",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.otp",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.fodp",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.key",
        "plugin": "endue.slides"
      },
      {
        "pattern": "*.gslides",
        "plugin": "endue.slides"
      }
    ],
    "commands": [
      {
        "id": "endue.slides.show",
        "title": "Slides: Show a slide",
        "description": "Show a slide of the open deck by its one-based number, including while it is playing.",
        "args": {
          "type": "object",
          "properties": {
            "slide": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": ["slide"]
        },
        "agent": true
      },
      {
        "id": "endue.slides.play",
        "title": "Slides: Play the deck",
        "description": "Start presentation mode at the one-based slide number or the slide currently on screen.",
        "args": {
          "type": "object",
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.slides.stop",
        "title": "Slides: Stop playing",
        "description": "Leave presentation mode and keep the slide last shown.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.slides.read",
        "title": "Slides: the open deck as text",
        "keywords": [
          "slides",
          "deck",
          "presentation",
          "powerpoint",
          "pptx",
          "keynote",
          "read",
          "notes"
        ],
        "description": "Read the open deck slide by slide, including shape and table text, titles, speaker notes and hidden status. The active deck also reports the slide currently visible in browse or presentation mode. Give path for another open deck and from and count for a part of it.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "from": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "total": {
              "type": "integer"
            },
            "slides": {
              "type": ["array", "null"]
            },
            "more": {
              "type": "boolean"
            },
            "decks": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
