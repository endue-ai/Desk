{
  "id": "desk.today",
  "name": "Today",
  "version": "0.1.0",
  "kind": "view",
  "description": "The day at a glance: today's events, the tasks due, unread messages, the notes touched last and your open GitHub work.",
  "view": {
    "id": "desk.today",
    "title": "Today",
    "description": "Today's events, the tasks due by tonight, unread messages, the notes touched last and your open GitHub work.",
    "columns": 2,
    "sections": [
      {
        "title": "Schedule",
        "type": "calendar",
        "source": {
          "items": {
            "kinds": ["event"],
            "where": [
              {
                "field": "start",
                "op": "lt",
                "value": "{tomorrow}"
              },
              {
                "field": "end",
                "op": "gt",
                "value": "{today}"
              }
            ],
            "sort": [
              {
                "field": "start",
                "dir": "asc"
              }
            ]
          }
        },
        "options": {
          "range": "day"
        },
        "empty": "Nothing on the calendar today."
      },
      {
        "title": "Due",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["task"],
            "where": [
              {
                "field": "status",
                "op": "eq",
                "value": "open"
              },
              {
                "field": "due",
                "op": "lt",
                "value": "{tomorrow}"
              }
            ],
            "sort": [
              {
                "field": "due",
                "dir": "asc"
              }
            ],
            "limit": 10
          }
        },
        "empty": "Nothing due."
      },
      {
        "title": "Unread",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "unread",
                "op": "eq",
                "value": true
              }
            ],
            "sort": [
              {
                "field": "receivedAt",
                "dir": "desc"
              }
            ],
            "limit": 10
          }
        },
        "empty": "No unread messages."
      },
      {
        "title": "Last touched",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["note"],
            "sort": [
              {
                "field": "updatedAt",
                "dir": "desc"
              }
            ],
            "limit": 5
          }
        },
        "empty": "No notes yet."
      },
      {
        "title": "GitHub",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["task"],
            "sources": ["desk.github"],
            "where": [
              {
                "field": "status",
                "op": "eq",
                "value": "open"
              }
            ],
            "sort": [
              {
                "field": "updatedAt",
                "dir": "desc"
              }
            ],
            "limit": 10
          }
        },
        "empty": "No open GitHub work."
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "desk.today.open",
        "title": "Open today",
        "keywords": ["today", "agenda", "day", "morning"],
        "runs": {
          "command": "desk.views.open",
          "args": {
            "id": "desk.today"
          }
        }
      }
    ],
    "keys": [
      {
        "key": "Mod+T",
        "command": "desk.today.open"
      }
    ]
  }
}
