    "settings": {
      "desk.theme.scheme": {
        "kind": "string",
        "default": "dark",
        "choices": ["system", "light", "dark"],
        "description": "Light or dark; system follows the OS."
      },
      "desk.theme.contrast": {
        "kind": "string",
        "default": "system",
        "choices": ["system", "normal", "high"],
        "description": "High contrast; system follows the OS."
      },
      "desk.theme.motion": {
        "kind": "string",
        "default": "system",
        "choices": ["system", "reduce", "full"],
        "description": "Reduced motion; system follows the OS."
      },
      "desk.theme.active": {
        "kind": "string",
        "default": "",
        "description": "The theme plugin in force, by id (a plugin of kind theme, ADR 0056); empty for the endue theme. Installing a theme does not apply it."
      },
      "desk.theme.markets": {
        "kind": "array",
        "default": [
          "https://raw.githubusercontent.com/endue-ai/endue/main/market/themes/index.json"
        ],
        "description": "The theme markets the studio's Market tab lists, by the https URL of each index (ADR 0060), in order: the first market that lists a theme's id wins. The default is this repository's market."
      }
