{
  "id": "desk.universal",
  "name": "Universal View",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "Opens a universal view: entries from inline data, a file, a URL, another plugin or the desk's items, drawn as a timeline, calendar, board, list, text, chat or agent run.",
  "permissions": [
    {
      "permission": "data:read"
    },
    {
      "permission": "fs:read",
      "paths": ["${home}/**"]
    },
    {
      "permission": "cmd:invoke",
      "ids": ["*"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Universal View",
      "placement": "overlay",
      "hidden": true
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "desk.universal.open",
        "title": "Open a universal view",
        "keywords": [
          "view",
          "timeline",
          "calendar",
          "kanban",
          "board",
          "list",
          "chat",
          "agent",
          "yaml"
        ]
      },
      {
        "id": "desk.universal.close",
        "title": "Close the universal view"
      },
      {
        "id": "desk.universal.allow",
        "title": "Allow the universal view's source",
        "keywords": ["permission", "access"]
      }
    ]
  }
}
