{
  "id": "endue.git",
  "name": "Git",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "A keyboard-first front for Git: the status of a repository, staging, commits, the log as a graph and diffs, every operation a command that runs the git program without a shell.",
  "permissions": [
    {
      "permission": "proc:spawn",
      "commands": ["git"]
    },
    {
      "permission": "cmd:invoke",
      "ids": [
        "desk.files.open",
        "desk.palette.pick",
        "desk.buffers.open",
        "desk.buffers.update",
        "endue.git.discard-patch",
        "endue.git.discard-files"
      ]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Git",
      "placement": "center"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.git.status",
        "title": "Git: status",
        "keywords": ["repository", "stage", "vc", "version control"],
        "agent": true,
        "description": "Open the Git repository containing the given folder and show its status."
      },
      {
        "id": "endue.git.state",
        "title": "Git: state",
        "keywords": ["branch", "changes", "repository"],
        "description": "The repository a path is in (else the open one) as data: root, branch, upstream, commits ahead and behind, the head commit, staged, unstaged, untracked and conflicted files, stashes and the ten latest commits.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "A folder inside the repository; the open repository when absent"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "branch": {
              "type": ["string", "null"]
            },
            "upstream": {
              "type": ["string", "null"]
            },
            "ahead": {
              "type": "integer"
            },
            "behind": {
              "type": "integer"
            },
            "head": {
              "type": ["string", "null"]
            },
            "staged": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "change": {
                    "type": "string"
                  },
                  "origPath": {
                    "type": "string"
                  }
                }
              }
            },
            "unstaged": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "change": {
                    "type": "string"
                  },
                  "origPath": {
                    "type": "string"
                  }
                }
              }
            },
            "untracked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "change": {
                    "type": "string"
                  },
                  "origPath": {
                    "type": "string"
                  }
                }
              }
            },
            "stashes": {
              "type": "array"
            },
            "recent": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.git.refresh",
        "title": "Git: refresh",
        "keywords": ["reload", "revert-buffer"]
      },
      {
        "id": "endue.git.stage",
        "title": "Git: stage",
        "keywords": ["add", "index"],
        "description": "Stage a file of the open repository, or every change with all. A supplied patch stages or unstages just its changes.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "A path relative to the repository's root"
            },
            "all": {
              "type": "boolean"
            },
            "patch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576,
              "description": "A Git diff patch to apply to the index"
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.git.unstage",
        "title": "Git: unstage",
        "keywords": ["reset", "index"],
        "description": "Take a file of the open repository out of the index, or every staged change with all. A supplied patch stages or unstages just its changes.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "A path relative to the repository's root"
            },
            "all": {
              "type": "boolean"
            },
            "patch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576,
              "description": "A Git diff patch to apply to the index"
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.git.discard",
        "title": "Git: discard changes",
        "keywords": ["restore", "checkout", "clean"],
        "description": "Discard the named file's unstaged changes after review. Undo restores the saved content.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "A path relative to the repository's root"
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.git.discard-patch",
        "title": "Git: discard part of a file",
        "keywords": ["hunk", "lines", "restore"],
        "description": "Take the change a patch from the open repository's unstaged diff makes out of the worktree, after asking. The desk's undo puts it back.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "A path relative to the repository's root"
            },
            "patch": {
              "type": "string",
              "minLength": 1,
              "description": "One hunk of the unstaged diff, as git diff writes it"
            },
            "what": {
              "type": "string",
              "description": "The words that name the change"
            }
          }
        },
        "undo": "endue.git.restore-patch",
        "agent": true
      },
      {
        "id": "endue.git.restore-patch",
        "title": "Git: put back a discarded part of a file",
        "keywords": ["undo", "hunk"]
      },
      {
        "id": "endue.git.commit",
        "title": "Git: commit",
        "keywords": ["amend", "sign-off"],
        "description": "Commit what is staged in the open repository with message (without one, the commit editor opens); amend rewrites the last commit, signOff adds a Signed-off-by line.",
        "args": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1
            },
            "amend": {
              "type": "boolean"
            },
            "signOff": {
              "type": "boolean"
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.git.log",
        "title": "Git: log",
        "keywords": ["history", "graph", "commits"]
      },
      {
        "id": "endue.git.diff",
        "title": "Git: diff",
        "keywords": ["changes", "patch", "staged"]
      },
      {
        "id": "endue.git.fetch",
        "title": "Git: fetch",
        "keywords": ["remote", "prune"],
        "description": "Fetch from a remote of the open repository (every remote's default when remote is absent) and prune what is gone.",
        "args": {
          "type": "object",
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.git.pull",
        "title": "Git: pull",
        "keywords": ["remote", "fast-forward"],
        "description": "Pull the open repository's branch from its upstream.",
        "args": {
          "type": "object",
          "properties": {}
        },
        "agent": true
      },
      {
        "id": "endue.git.push",
        "title": "Git: push",
        "keywords": ["remote", "upstream"],
        "description": "Push the open repository's branch to a remote (its upstream when remote is absent); force pushes with --force-with-lease after asking.",
        "args": {
          "type": "object",
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "force": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.git.checkout",
        "title": "Git: switch branch",
        "keywords": ["branch", "switch", "create"],
        "description": "Switch the open repository to the branch or commit ref (without one, a pick offers the branches).",
        "args": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.git.branches",
        "title": "Git: find a branch",
        "keywords": ["branch", "switch", "palette"],
        "description": "Read the open repository's local and remote branch data.",
        "agent": true,
        "readOnly": true,
        "args": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "endue.git.visit",
        "title": "Git: open the file",
        "keywords": ["find-file"]
      },
      {
        "id": "endue.git.cancel",
        "title": "Git: cancel the running operation",
        "keywords": ["kill"]
      },
      {
        "id": "endue.git.commits",
        "title": "Git: read commits",
        "description": "Read a bounded page of commit history, optionally across all branches.",
        "args": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "skip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "all": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.git.diff-text",
        "title": "Git: read diff text",
        "description": "Read a working, staged or commit diff as bounded plain text.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "staged": {
              "type": "boolean"
            },
            "sha": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{4,64}$"
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.git.stash",
        "title": "Git: stash pending changes",
        "description": "Save tracked pending changes in a new local stash, optionally with a message.",
        "args": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.git.stash-pop",
        "title": "Git: pop a stash",
        "description": "Reapply the named stash and its staged state, then drop it on success.",
        "args": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^stash@\\{[0-9]{1,9}\\}$"
            }
          },
          "required": ["ref"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.git.stash-drop",
        "title": "Git: delete a stash",
        "description": "Permanently delete the specified local stash.",
        "args": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^stash@\\{[0-9]{1,9}\\}$"
            }
          },
          "required": ["ref"],
          "additionalProperties": false
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.git.discard-files",
        "title": "Git: apply a reviewed file discard",
        "description": "Save the inverse of the selected file changes and discard them.",
        "args": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "untracked": {
              "type": "boolean"
            },
            "all": {
              "type": "boolean"
            }
          },
          "required": ["root", "path", "untracked", "all"],
          "additionalProperties": false
        },
        "undo": "endue.git.restore-files"
      },
      {
        "id": "endue.git.restore-files",
        "title": "Git: restore discarded files",
        "description": "Restore the saved changes of a reviewed file discard."
      }
    ],
    "keys": [
      {
        "key": "Mod+Shift+G",
        "command": "endue.git.status"
      }
    ],
    "paletteProviders": [
      {
        "command": "endue.git.branches",
        "title": "Branches"
      }
    ],
    "settings": {
      "endue.git.log-count": {
        "kind": "integer",
        "default": 200,
        "description": "How many commits the log loads at a time."
      },
      "endue.git.diff-context": {
        "kind": "integer",
        "default": 3,
        "description": "Lines of context around each change in a diff."
      },
      "endue.git.sign-off": {
        "kind": "boolean",
        "default": false,
        "description": "Add a Signed-off-by trailer to every commit (DCO)."
      },
      "endue.git.pull-rebase": {
        "kind": "boolean",
        "default": false,
        "description": "Pull with --rebase instead of --ff-only."
      },
      "endue.git.confirm": {
        "kind": "boolean",
        "default": true,
        "description": "Ask before discarding changes or pushing with --force-with-lease."
      },
      "endue.git.recent-max": {
        "kind": "integer",
        "default": 10,
        "description": "How many repositories to remember for the repository pick."
      }
    }
  }
}
