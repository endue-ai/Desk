      },
      {
        "pattern": "*.vmdk",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.qcow2",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.wim",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.snap",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.AppImage",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.arj",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.lha",
        "plugin": "endue.archives"
