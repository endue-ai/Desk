        "plugin": "endue.archives"
      },
      {
        "pattern": "*.crx",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.nupkg",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.whl",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.egg",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.appx",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.appxbundle",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.msix",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.msixbundle",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.tar",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.tgz",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.tbz",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.tbz2",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.txz",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.tzst",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.gz",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.bz2",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.xz",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.lzma",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.zst",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.lz4",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.Z",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.7z",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.rar",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.cab",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.iso",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.deb",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.rpm",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.gem",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.pkg",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.xar",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.msi",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.dmg",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.img",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.vhd",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.vhdx",
