  "name": "Archives",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "Opens every archive, package and disk image as a tree with a preview of the selected entry, and extracts to a folder the person picks. It never changes the archive.",
