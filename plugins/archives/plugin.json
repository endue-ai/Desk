{
  "id": "endue.archives",
  "name": "Archives",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens every archive, package and disk image as a tree with a preview of the selected entry, and extracts to a folder the person picks. It never changes the archive.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed", "desk.palette.pick"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "fs:write",
      "paths": ["/**"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Archives",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.zip",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.zipx",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.jar",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.war",
        "plugin": "endue.archives"
      },
      {
        "pattern": "*.ear",
