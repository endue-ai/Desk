{
  "id": "endue.image-studio",
  "name": "Image Studio",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "Edit raster images with crop, resize, rotate, flip, color adjustments, blur, sharpen and undo. Export the result as PNG.",
  "permissions": [
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "fs:write",
      "paths": ["/**"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Image Studio",
      "placement": "center",
      "window": {
        "size": {
          "width": 1000,
          "height": 700
        }
      }
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.image-studio.open",
        "title": "Image Studio: Open an image",
        "description": "Open a PNG, JPEG or WebP from an exact path already granted to Image Studio. Export or discard a current draft before replacing it.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.image-studio.inspect",
        "title": "Image Studio: Inspect the current image",
        "description": "Read the document ID, revision, dimensions, and undo and redo availability. Use the document ID and revision for edits.",
        "agent": true,
        "readOnly": true,
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.image-studio.apply",
        "title": "Image Studio: Apply image edits",
        "description": "Apply an ordered batch of up to 16 edits atomically to the identified document revision. Coordinates and dimensions are in pixels at each step.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "crop"
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16383
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16383
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16384
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16384
                      }
                    },
                    "required": ["op", "x", "y", "width", "height"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "resize"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16384
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16384
                      }
                    },
                    "required": ["op", "width", "height"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "rotate"
                      },
                      "degrees": {
                        "enum": [90, 180, 270]
                      }
                    },
                    "required": ["op", "degrees"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "flip"
                      },
                      "axis": {
                        "enum": ["horizontal", "vertical"]
                      }
                    },
                    "required": ["op", "axis"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "adjust"
                      },
                      "brightness": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100
                      },
                      "contrast": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100
                      },
                      "saturation": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100
                      }
                    },
                    "required": ["op", "brightness", "contrast", "saturation"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "invert"
                      }
                    },
                    "required": ["op"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "blur"
                      },
                      "radius": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32
                      }
                    },
                    "required": ["op", "radius"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "sharpen"
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    },
                    "required": ["op", "amount"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": ["document", "revision", "operations"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.image-studio.undo",
        "title": "Image Studio: Undo an edit batch",
        "description": "Undo the last batch for the identified document revision.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["document", "revision"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.image-studio.redo",
        "title": "Image Studio: Redo an edit batch",
        "description": "Redo the next batch for the identified document revision.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["document", "revision"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.image-studio.export",
        "title": "Image Studio: Export a PNG",
        "description": "Export the current image to a destination chosen in the save dialog."
      }
    ]
  }
}
