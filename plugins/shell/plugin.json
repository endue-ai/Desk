{
  "id": "desk.shell",
  "name": "Shell",
  "version": "0.1.0",
  "kind": "policy",
  "description": "The desk shell's own policy: a profile's named desktops and what it lays out on each, the keys that switch desktops and move windows between them, Eris's mesh and soul text, the shell's colours on top of desk.theme, and the sample profiles.",
  "contributes": {
    "keys": [
      { "key": "Mod+1", "command": "desk.shell.desktop-1" },
      { "key": "Mod+2", "command": "desk.shell.desktop-2" },
      { "key": "Mod+3", "command": "desk.shell.desktop-3" },
      { "key": "Mod+4", "command": "desk.shell.desktop-4" },
      { "key": "Mod+5", "command": "desk.shell.desktop-5" },
      { "key": "Mod+6", "command": "desk.shell.desktop-6" },
      { "key": "Mod+7", "command": "desk.shell.desktop-7" },
      { "key": "Mod+8", "command": "desk.shell.desktop-8" },
      { "key": "Mod+9", "command": "desk.shell.desktop-9" },
      {
        "key": "Mod+Shift+1",
        "mac": "Control+Shift+1",
        "command": "desk.shell.move-to-desktop-1"
      },
      {
        "key": "Mod+Shift+2",
        "mac": "Control+Shift+2",
        "command": "desk.shell.move-to-desktop-2"
      },
      {
        "key": "Mod+Shift+3",
        "mac": "Control+Shift+3",
        "command": "desk.shell.move-to-desktop-3"
      },
      {
        "key": "Mod+Shift+4",
        "mac": "Control+Shift+4",
        "command": "desk.shell.move-to-desktop-4"
      },
      {
        "key": "Mod+Shift+5",
        "mac": "Control+Shift+5",
        "command": "desk.shell.move-to-desktop-5"
      },
      {
        "key": "Mod+Shift+6",
        "mac": "Control+Shift+6",
        "command": "desk.shell.move-to-desktop-6"
      },
      {
        "key": "Mod+Shift+7",
        "mac": "Control+Shift+7",
        "command": "desk.shell.move-to-desktop-7"
      },
      {
        "key": "Mod+Shift+8",
        "mac": "Control+Shift+8",
        "command": "desk.shell.move-to-desktop-8"
      },
      {
        "key": "Mod+Shift+9",
        "mac": "Control+Shift+9",
        "command": "desk.shell.move-to-desktop-9"
      },
      { "key": "Mod+Shift+]", "command": "desk.shell.desktop-next" },
      { "key": "Mod+Shift+[", "command": "desk.shell.desktop-previous" },
      { "key": "Mod+Shift+\\", "command": "desk.shell.desktops-overview" }
    ],
    "settings": {
      "desk.roles": {
        "kind": "object",
        "default": {},
        "description": "Who fills each role (ADR 0104), role to plugin id: role:rail, role:agents and role:dock are the shell's edges, role:palette the palette, role:settings-ui the settings window. A role left out keeps its default; a provider named here that is off leaves its role empty."
      },
      "desk.shell.mode": {
        "kind": "object",
        "default": {
          "icon": "sparkle",
          "author": "endue",
          "version": "1.0.0",
          "eris": {
            "scope": {
              "folders": ["~/Documents"],
              "calendar": true,
              "mail": false,
              "mic": "wake-word"
            },
            "manner": {
              "interrupt": "attention-only",
              "voice": true,
              "greeting": "Good morning."
            }
          },
          "triggers": {
            "manual": true
          }
        },
        "description": "What a profile lays out: its icon, author and version, the layout every desktop starts from, its desktops as a list (each with an id, a name and its own layout; four named 1 to 4 when it names none), Eris's scope and manner, its roles and triggers. A profile's value layers over this one."
      },
      "desk.shell.layouts": {
        "kind": "object",
        "default": {},
        "description": "Desktops changed since the profile was saved: the list of desktops, each with its id and name and, when moved, its layout. Saving the profile keeps them; reverting drops them."
      },
      "desk.shell.density": {
        "kind": "string",
        "default": "balanced",
        "choices": ["airy", "balanced", "dense"],
        "description": "How fine Eris's mesh is."
      },
      "desk.shell.soul": {
        "kind": "string",
        "default": "wisp",
        "choices": ["wisp", "solemn"],
        "description": "How Eris's soul text moves."
      },
      "desk.shell.talk-place": {
        "kind": "object",
        "default": {},
        "description": "Where the talk line sits once the person moved it: its bottom centre as shares of the app's width and height ({ x, y }, 0 to 1). Empty: centred on the bottom edge."
      }
    },
    "themes": [
      {
        "id": "desk.shell.dark",
        "name": "endue shell, dark",
        "scheme": "dark",
        "tokens": {
          "secondary": "#30283e",
          "secondaryForeground": "#e4d7ff",
          "statusActive": "#5fd0be",
          "statusAttention": "#e0738a",
          "statusAttentionSoft": "rgba(224, 115, 138, 0.14)",
          "statusAttentionText": "#fa8aa1",
          "successFill": "#4caf50",
          "infoFill": "#5b9bf5",
          "warningFill": "#ff9800",
          "dotOutline": "transparent",
          "glow": "rgba(182, 163, 245, 0.07)",
          "glowEnd": "rgba(182, 163, 245, 0)",
          "eris": "#e8c98a",
          "erisFrost": "#e9edf4",
          "erisShade": "#a7b1c3",
          "erisGoldLight": "#f5e2b4",
          "erisGoldDeep": "#d4a85f",
          "erisGoldDimLight": "#d9c79f",
          "erisGoldDimDeep": "#a88a58",
          "erisMoonDark": "#2c2836",
          "erisMoonLit": "#8f87a8",
          "erisWhite": "#ffffff",
          "erisGlow": "rgba(233, 237, 244, 0.35)"
        }
      },
      {
        "id": "desk.shell.light",
        "name": "endue shell, light",
        "scheme": "light",
        "tokens": {
          "secondary": "#eae4f2",
          "secondaryForeground": "#1e1833",
          "statusActive": "#5fd0be",
          "statusAttention": "#e0738a",
          "statusAttentionSoft": "rgba(224, 115, 138, 0.14)",
          "statusAttentionText": "#b23a55",
          "successFill": "oklch(0.595 0.17 163)",
          "infoFill": "oklch(0.65 0.15 245)",
          "warningFill": "oklch(0.75 0.17 70)",
          "dotOutline": "#897f95",
          "glow": "rgba(182, 163, 245, 0.07)",
          "glowEnd": "rgba(182, 163, 245, 0)",
          "eris": "#9a6b12",
          "erisFrost": "#4a5d7e",
          "erisShade": "#6e7890",
          "erisGoldLight": "#d4a85f",
          "erisGoldDeep": "#8f6414",
          "erisGoldDimLight": "#c2ad84",
          "erisGoldDimDeep": "#85704a",
          "erisMoonDark": "#2c2836",
          "erisMoonLit": "#8f87a8",
          "erisWhite": "#ffffff",
          "erisGlow": "rgba(74, 93, 126, 0.2)"
        }
      }
    ],
    "profiles": [
      {
        "id": "morning",
        "name": "Morning",
        "plugins": {
          "disabled": ["endue.sidebar", "endue.toolbar"]
        },
        "settings": {
          "desk.shell.mode": {
            "icon": "sunrise",
            "author": "me",
            "desktops": {
              "2": {
                "surfaces": [
                  {
                    "id": "calendar",
                    "plugin": "endue.calendar",
                    "x": 120,
                    "y": 240,
                    "w": 560,
                    "h": 400,
                    "pinned": false
                  },
                  {
                    "id": "tomorrow",
                    "plugin": "endue.eris",
                    "x": 1000,
                    "y": 220,
                    "w": 320,
                    "h": 360,
                    "pinned": false
                  }
                ]
              },
              "3": {
                "surfaces": [
                  {
                    "id": "notes",
                    "plugin": "endue.notes",
                    "x": 140,
                    "y": 260,
                    "w": 380,
                    "h": 300,
                    "pinned": false
                  }
                ]
              }
            },
            "roles": [
              {
                "role": "scheduler",
                "agent": "mira"
              }
            ],
            "triggers": {
              "manual": true,
              "time": "07:00-10:00"
            }
          }
        }
      },
      {
        "id": "deep-work",
        "name": "Deep work",
        "plugins": {
          "disabled": ["endue.sidebar", "endue.toolbar"]
        },
        "settings": {
          "desk.shell.mode": {
            "icon": "target",
            "author": "me",
            "desktops": {
              "1": {
                "surfaces": [
                  {
                    "id": "notes",
                    "plugin": "endue.notes",
                    "x": 140,
                    "y": 220,
                    "w": 420,
                    "h": 420,
                    "pinned": false
                  }
                ],
                "eris": {
                  "x": 1180,
                  "y": 96
                }
              }
            },
            "roles": [
              {
                "role": "scheduler",
                "agent": "mira"
              }
            ],
            "eris": {
              "scope": {
                "folders": ["~/Projects"],
                "calendar": false,
                "mail": false,
                "mic": "off"
              },
              "manner": {
                "interrupt": "none",
                "voice": false,
                "greeting": "Focus time."
              }
