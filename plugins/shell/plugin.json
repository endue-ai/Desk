      {
        "id": "studio",
        "name": "Studio",
        "plugins": {
          "disabled": ["endue.sidebar", "endue.toolbar"]
        },
        "settings": {
          "desk.shell.mode": {
            "icon": "palette",
            "author": "me",
            "copiedFrom": {
              "author": "jin",
              "id": "studio",
              "version": "2.1.0"
            },
            "desktops": {
              "1": {
                "surfaces": [
                  {
                    "id": "notes",
