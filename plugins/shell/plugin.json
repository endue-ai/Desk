            "author": "me",
            "desktop": {
              "rail": {
                "visible": false
              }
            },
            "eris": {
              "scope": {
                "folders": [],
                "calendar": false,
                "mail": false,
                "mic": "off"
              },
              "manner": {
                "interrupt": "none",
                "voice": false,
                "greeting": "Good night."
              }
            },
            "triggers": {
              "manual": true,
              "time": "22:00-06:00"
            }
          }
        }
      }
    ]
  }
}
