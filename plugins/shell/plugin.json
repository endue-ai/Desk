                    "x": 1000,
                    "y": 240,
                    "w": 340,
                    "h": 320,
                    "pinned": false
                  }
                ]
              }
            },
            "roles": [
              {
                "role": "scheduler",
                "agent": null
              }
            ],
            "eris": {
              "scope": {
                "folders": ["~/Documents"],
                "calendar": true,
                "mail": false,
                "mic": "wake-word"
              },
              "manner": {
                "interrupt": "all",
                "voice": true,
                "greeting": "Studio is open."
