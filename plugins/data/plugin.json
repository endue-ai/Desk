{
  "id": "endue.data",
  "name": "Data",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens structured data and configuration files (JSON, JSON5, JSON Lines, YAML, TOML, XML, property lists, INI, properties, dotenv, HCL, MessagePack, CBOR, BSON) as a tree and raw text, with search, paths, parse errors at their line, JSON Schema checks and masked secrets. It edits values of JSON and JSONC losslessly, and of YAML and TOML as text; the other formats are read-only.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed", "desk.palette.pick", "desk.buffers.update"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "fs:write",
      "paths": ["/**"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Data",
      "placement": "center",
      "instances": "per-file"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.json",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.jsonc",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.json5",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.jsonl",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.ndjson",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.yaml",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.yml",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.toml",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.xml",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.xsd",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.xsl",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.xslt",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.plist",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.ini",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.cfg",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.conf",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.properties",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.env",
        "plugin": "endue.data"
      },
      {
        "pattern": ".env",
        "plugin": "endue.data"
      },
      {
        "pattern": ".env.*",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.hcl",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.tf",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.tfvars",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.msgpack",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.bson",
        "plugin": "endue.data"
      },
      {
        "pattern": "*.cbor",
        "plugin": "endue.data"
      }
    ],
    "settings": {
      "endue.data.mask-secrets": {
        "kind": "boolean",
        "default": true,
        "description": "Show values whose key looks like a secret (password, passwd, secret, token, api_key, apikey, private_key) as dots until revealed. dotenv values are always masked."
      }
    },
    "commands": [
      {
        "id": "endue.data.read",
        "title": "Data: the open file as data",
        "keywords": ["data", "json", "yaml", "toml", "xml", "csv", "env", "config", "read"],
        "description": "The file in the Data window in use (JSON, YAML, TOML, XML, .env, plist and the other formats Data opens), or the open one named by path, as the value at pointer (a JSON Pointer, /servers/0/host; the whole document without it) nested to depth (3, at most 8; deeper branches say how many children they hold, a branch lists 200 at most). document picks one of several (YAML documents, JSON Lines). Values Data masks, every .env value and values under keys that look like a password, secret, token or key, come back as [secret] even when the person revealed them; the raw text is never answered. errors lists what did not parse. It leaves the screen as it is. Data reads only what the desk opened in it: open a file with desk.files.open first, which brings its window into use.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "pointer": {
              "type": "string",
              "maxLength": 4096
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "document": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "documents": {
              "type": "integer"
            },
            "pointer": {
              "type": "string"
            },
            "value": {},
            "errors": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
