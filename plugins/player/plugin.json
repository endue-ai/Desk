{
  "id": "endue.player",
  "name": "Player",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "Plays every video and audio file in one player: one transport, subtitles drawn over the video, playlists and CUE chapters, and each file's tags and cover. What the system's WebKit cannot play opens as its details. It never writes a file.",
  "permissions": [{ "permission": "cmd:invoke", "ids": ["desk.files.changed"] }],
  "surfaces": [{ "id": "main", "title": "Player", "placement": "center" }],
  "contributes": {
    "files": [
      { "pattern": "*.mp4", "plugin": "endue.player" },
      { "pattern": "*.m4v", "plugin": "endue.player" },
      { "pattern": "*.mov", "plugin": "endue.player" },
      { "pattern": "*.qt", "plugin": "endue.player" },
      { "pattern": "*.mkv", "plugin": "endue.player" },
      { "pattern": "*.webm", "plugin": "endue.player" },
      { "pattern": "*.avi", "plugin": "endue.player" },
      { "pattern": "*.wmv", "plugin": "endue.player" },
      { "pattern": "*.asf", "plugin": "endue.player" },
      { "pattern": "*.flv", "plugin": "endue.player" },
      { "pattern": "*.f4v", "plugin": "endue.player" },
      { "pattern": "*.mpg", "plugin": "endue.player" },
      { "pattern": "*.mpeg", "plugin": "endue.player" },
      { "pattern": "*.m2ts", "plugin": "endue.player" },
      { "pattern": "*.mts", "plugin": "endue.player" },
      { "pattern": "*.vob", "plugin": "endue.player" },
      { "pattern": "*.3gp", "plugin": "endue.player" },
      { "pattern": "*.3g2", "plugin": "endue.player" },
      { "pattern": "*.ogv", "plugin": "endue.player" },
      { "pattern": "*.rm", "plugin": "endue.player" },
      { "pattern": "*.rmvb", "plugin": "endue.player" },
      { "pattern": "*.mxf", "plugin": "endue.player" },
      { "pattern": "*.mp3", "plugin": "endue.player" },
      { "pattern": "*.aac", "plugin": "endue.player" },
      { "pattern": "*.m4a", "plugin": "endue.player" },
      { "pattern": "*.m4b", "plugin": "endue.player" },
      { "pattern": "*.wav", "plugin": "endue.player" },
      { "pattern": "*.aif", "plugin": "endue.player" },
      { "pattern": "*.aiff", "plugin": "endue.player" },
      { "pattern": "*.aifc", "plugin": "endue.player" },
      { "pattern": "*.flac", "plugin": "endue.player" },
      { "pattern": "*.ogg", "plugin": "endue.player" },
      { "pattern": "*.oga", "plugin": "endue.player" },
      { "pattern": "*.opus", "plugin": "endue.player" },
      { "pattern": "*.weba", "plugin": "endue.player" },
      { "pattern": "*.caf", "plugin": "endue.player" },
      { "pattern": "*.wma", "plugin": "endue.player" },
      { "pattern": "*.ape", "plugin": "endue.player" },
      { "pattern": "*.wv", "plugin": "endue.player" },
      { "pattern": "*.mka", "plugin": "endue.player" },
      { "pattern": "*.amr", "plugin": "endue.player" },
      { "pattern": "*.dsf", "plugin": "endue.player" },
      { "pattern": "*.dff", "plugin": "endue.player" },
      { "pattern": "*.au", "plugin": "endue.player" },
      { "pattern": "*.snd", "plugin": "endue.player" },
      { "pattern": "*.mid", "plugin": "endue.player" },
      { "pattern": "*.midi", "plugin": "endue.player" },
      { "pattern": "*.srt", "plugin": "endue.player" },
      { "pattern": "*.vtt", "plugin": "endue.player" },
      { "pattern": "*.ass", "plugin": "endue.player" },
      { "pattern": "*.ssa", "plugin": "endue.player" },
      { "pattern": "*.sbv", "plugin": "endue.player" },
      { "pattern": "*.ttml", "plugin": "endue.player" },
      { "pattern": "*.dfxp", "plugin": "endue.player" },
      { "pattern": "*.smi", "plugin": "endue.player" },
      { "pattern": "*.sami", "plugin": "endue.player" },
      { "pattern": "*.m3u", "plugin": "endue.player" },
      { "pattern": "*.m3u8", "plugin": "endue.player" },
      { "pattern": "*.pls", "plugin": "endue.player" },
      { "pattern": "*.xspf", "plugin": "endue.player" },
      { "pattern": "*.cue", "plugin": "endue.player" }
    ],
    "settings": {
      "endue.player.resume": {
        "kind": "boolean",
        "default": true,
        "description": "Keep the position of files longer than ten minutes and offer to resume there on the next visit."
      }
    }
  }
}
