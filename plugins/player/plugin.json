{
  "id": "endue.player",
  "name": "Player",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Plays video and audio files in one player: one transport, subtitles drawn over the video, playlists and CUE chapters, and each file's tags and cover. What the desk's engine cannot play itself is remuxed for Media Source Extensions or decoded by FFmpeg in WebAssembly; a codec neither decodes, and damaged and protected files, open as their details, which say why and show the file in the file manager for another app. It never writes a file.",
  "permissions": [
    { "permission": "cmd:invoke", "ids": ["desk.files.changed", "desk.files.playlist-entries"] },
    { "permission": "shell:open", "paths": ["${home}/**"] },
    { "permission": "fs:read", "paths": ["/**"] },
    { "permission": "shell:open", "paths": ["/**"] }
  ],
  "surfaces": [{ "id": "main", "title": "Player", "placement": "center" }],
  "contributes": {
    "commands": [
      {
        "id": "endue.player.view",
        "title": "Player: Set loop and theatre mode",
        "description": "Set loop, theatre mode for a video, or both, using the existing transport controls.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": { "loop": { "type": "boolean" }, "theatre": { "type": "boolean" } },
          "additionalProperties": false
        }
      },
      {
        "id": "endue.player.chapter",
        "title": "Player: Show a chapter",
        "description": "Seek to the one-based chapter of the current item. The state tool lists chapters.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": { "at": { "type": "integer", "minimum": 1 } },
          "required": ["at"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.player.retry",
        "title": "Player: Retry the current media",
        "description": "Retry the current item at its kept position with the existing file read grant.",
        "agent": true,
        "args": { "type": "object", "properties": {}, "additionalProperties": false }
      },
      {
        "id": "endue.player.state",
        "title": "Player: Read the current player",
        "description": "Read the current item, playback position, duration, playing state, tags, subtitle tracks, loop, theatre mode, chapters and playlist entry.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "readOnly": true,
        "agent": true
      },
      {
        "id": "endue.player.play",
        "title": "Player: Play the current item",
        "description": "Start or continue the current item.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.player.pause",
        "title": "Player: Pause the current item",
        "description": "Pause the current item at its current position.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.player.seek",
        "title": "Player: Seek in the current item",
        "description": "Seek to an absolute time or relative to the current position, in seconds. Give exactly one of to or by.",
        "args": {
          "type": "object",
          "properties": {
            "to": { "type": "number" },
            "by": { "type": "number" }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.player.volume",
        "title": "Player: Set volume or mute",
        "description": "Set the volume from 0 to 1 or set mute explicitly. Give exactly one of level or mute.",
        "args": {
          "type": "object",
          "properties": {
            "level": { "type": "number", "minimum": 0, "maximum": 1 },
            "mute": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.player.speed",
        "title": "Player: Set playback speed",
        "description": "Set the transport's playback rate.",
        "args": {
          "type": "object",
          "properties": {
            "rate": { "enum": [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2] }
          },
          "required": ["rate"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.player.subtitles",
        "title": "Player: Choose subtitles",
        "description": "Choose a track id from state, on for the first available track, or off. An optional offset is in seconds, positive for later.",
        "args": {
          "type": "object",
          "properties": {
            "track": { "type": "string" },
            "offset": { "type": "number" }
          },
          "required": ["track"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.player.entry",
        "title": "Player: Choose a playlist entry",
        "description": "Open the one-based playlist entry, or move next, previous, first or last among readable local entries.",
        "args": {
          "type": "object",
          "properties": {
            "to": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "enum": ["next", "previous", "first", "last"] }
              ]
            }
          },
          "required": ["to"],
          "additionalProperties": false
        },
        "agent": true
      }
    ],
    "files": [
      { "pattern": "*.mp4", "plugin": "endue.player" },
      { "pattern": "*.m4v", "plugin": "endue.player" },
      { "pattern": "*.mov", "plugin": "endue.player" },
      { "pattern": "*.qt", "plugin": "endue.player" },
      { "pattern": "*.mkv", "plugin": "endue.player" },
      { "pattern": "*.webm", "plugin": "endue.player" },
      { "pattern": "*.avi", "plugin": "endue.player" },
      { "pattern": "*.wmv", "plugin": "endue.player" },
      { "pattern": "*.asf", "plugin": "endue.player" },
      { "pattern": "*.flv", "plugin": "endue.player" },
      { "pattern": "*.f4v", "plugin": "endue.player" },
      { "pattern": "*.mpg", "plugin": "endue.player" },
      { "pattern": "*.mpeg", "plugin": "endue.player" },
      { "pattern": "*.m2ts", "plugin": "endue.player" },
      { "pattern": "*.mts", "plugin": "endue.player" },
      { "pattern": "*.vob", "plugin": "endue.player" },
      { "pattern": "*.3gp", "plugin": "endue.player" },
      { "pattern": "*.3g2", "plugin": "endue.player" },
      { "pattern": "*.ogv", "plugin": "endue.player" },
      { "pattern": "*.rm", "plugin": "endue.player" },
      { "pattern": "*.rmvb", "plugin": "endue.player" },
      { "pattern": "*.mxf", "plugin": "endue.player" },
      { "pattern": "*.mp3", "plugin": "endue.player" },
      { "pattern": "*.aac", "plugin": "endue.player" },
      { "pattern": "*.m4a", "plugin": "endue.player" },
      { "pattern": "*.m4b", "plugin": "endue.player" },
      { "pattern": "*.wav", "plugin": "endue.player" },
      { "pattern": "*.aif", "plugin": "endue.player" },
      { "pattern": "*.aiff", "plugin": "endue.player" },
      { "pattern": "*.aifc", "plugin": "endue.player" },
      { "pattern": "*.flac", "plugin": "endue.player" },
      { "pattern": "*.ogg", "plugin": "endue.player" },
      { "pattern": "*.oga", "plugin": "endue.player" },
      { "pattern": "*.opus", "plugin": "endue.player" },
      { "pattern": "*.weba", "plugin": "endue.player" },
      { "pattern": "*.caf", "plugin": "endue.player" },
      { "pattern": "*.wma", "plugin": "endue.player" },
      { "pattern": "*.ape", "plugin": "endue.player" },
      { "pattern": "*.wv", "plugin": "endue.player" },
      { "pattern": "*.mka", "plugin": "endue.player" },
      { "pattern": "*.amr", "plugin": "endue.player" },
      { "pattern": "*.dsf", "plugin": "endue.player" },
      { "pattern": "*.dff", "plugin": "endue.player" },
      { "pattern": "*.au", "plugin": "endue.player" },
      { "pattern": "*.snd", "plugin": "endue.player" },
      { "pattern": "*.mid", "plugin": "endue.player" },
      { "pattern": "*.midi", "plugin": "endue.player" },
      { "pattern": "*.srt", "plugin": "endue.player" },
      { "pattern": "*.vtt", "plugin": "endue.player" },
      { "pattern": "*.ass", "plugin": "endue.player" },
      { "pattern": "*.ssa", "plugin": "endue.player" },
      { "pattern": "*.sbv", "plugin": "endue.player" },
      { "pattern": "*.ttml", "plugin": "endue.player" },
      { "pattern": "*.dfxp", "plugin": "endue.player" },
      { "pattern": "*.smi", "plugin": "endue.player" },
      { "pattern": "*.sami", "plugin": "endue.player" },
      { "pattern": "*.m3u", "plugin": "endue.player" },
      { "pattern": "*.m3u8", "plugin": "endue.player" },
      { "pattern": "*.pls", "plugin": "endue.player" },
      { "pattern": "*.xspf", "plugin": "endue.player" },
      { "pattern": "*.cue", "plugin": "endue.player" }
    ],
    "settings": {
      "endue.player.resume": {
        "kind": "boolean",
        "default": true,
        "description": "Keep the position of files longer than ten minutes and offer to resume there on the next visit."
      }
    }
  }
}
