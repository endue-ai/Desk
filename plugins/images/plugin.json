{
  "id": "endue.images",
  "name": "Images",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens still images in one viewer: the web formats the desk's engine decodes, its own decoders for TGA, Netpbm, QOI, DDS, HDR, OpenEXR, ICNS, KTX, DICOM, FITS and NIfTI, camera RAW previews; zoom, pan, rotate, details and EXIF, the folder's other images, and two images side by side. A format it cannot show opens as details that say why and show the file in the file manager for another app. It never writes a file.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed", "desk.files.open", "desk.buffers.close"]
    },
    {
      "permission": "shell:open",
      "paths": ["${home}/**"]
    },
    { "permission": "fs:read", "paths": ["/**"] },
    { "permission": "shell:open", "paths": ["/**"] }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Images",
      "placement": "center",
      "instances": "per-file"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.images.details",
        "title": "Images: Read the current image",
        "description": "Read the visible image's dimensions, parsed EXIF, folder position and view transforms.",
        "args": {
          "type": "object",
          "properties": {
            "window": {
              "type": "string",
              "description": "The Images pane's view from desk.windows.list, such as plugin:endue.images@2."
            }
          },
          "additionalProperties": false
        },
        "readOnly": true,
        "agent": true
      },
      {
        "id": "endue.images.zoom",
        "title": "Images: Set image zoom",
        "description": "Set the view scale, where 1 is 100%, or fit the image to the pane.",
        "args": {
          "type": "object",
          "properties": {
            "level": {
              "anyOf": [{ "type": "number", "minimum": 0.01, "maximum": 64 }, { "const": "fit" }]
            },
            "window": {
              "type": "string",
              "description": "The Images pane's view from desk.windows.list, such as plugin:endue.images@2."
            }
          },
          "required": ["level"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.images.turn",
        "title": "Images: Turn the image view",
        "description": "Rotate by degrees in multiples of 90 or set whether the image is mirrored. Changes only the view.",
        "args": {
          "type": "object",
          "properties": {
            "rotate": { "type": "integer", "multipleOf": 90 },
            "flip": { "type": "boolean" },
            "window": {
              "type": "string",
              "description": "The Images pane's view from desk.windows.list, such as plugin:endue.images@2."
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.images.step",
        "title": "Images: Walk the image folder",
        "description": "Show the next, previous, first or last image in this pane's folder.",
        "args": {
          "type": "object",
          "properties": {
            "to": { "enum": ["next", "previous", "first", "last"] },
            "window": {
              "type": "string",
              "description": "The Images pane's view from desk.windows.list, such as plugin:endue.images@2."
            }
          },
          "required": ["to"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.images.compare",
        "title": "Images: Compare images",
        "description": "Show a second image beside the current image using an existing read grant. Pass null to end the comparison.",
        "args": {
          "type": "object",
          "properties": {
            "path": { "type": ["string", "null"] },
            "window": {
              "type": "string",
              "description": "The Images pane's view from desk.windows.list, such as plugin:endue.images@2."
            }
          },
          "required": ["path"],
          "additionalProperties": false
        },
        "agent": true
      }
    ],
    "files": [
