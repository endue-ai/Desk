 <office:body>
  <office:text>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Field notes</text:h>
   <text:p text:style-name="Standard">The survey covered <text:span text:style-name="T1">three regions</text:span> over <text:span text:style-name="T2">six weeks</text:span>.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Counted from the first visit.</text:p></text:note-body></text:note> Details are on the <text:a xlink:type="simple" xlink:href="https://example.com/survey">project page</text:a>.</text:p>
   <text:p text:style-name="Standard">The <office:annotation office:name="c1"><dc:creator>Mina Park</dc:creator><dc:date>2026-10-20T10:30:00</dc:date><text:p>Check against the raw counts.</text:p></office:annotation>totals<office:annotation-end office:name="c1"/> below are <text:span text:style-name="T3">provisional</text:span>.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Steps</text:h>
   <text:list text:style-name="Numbering_20_123">
    <text:list-item><text:p text:style-name="Standard">Plan the route</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Standard">Visit each site</text:p>
     <text:list><text:list-item><text:p text:style-name="Standard">Morning count</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">Evening count</text:p></text:list-item></text:list>
    </text:list-item>
    <text:list-item><text:p text:style-name="Standard">Write the report</text:p></text:list-item>
   </text:list>
   <text:list text:style-name="List_20_1">
    <text:list-item><text:p text:style-name="Standard">Bring water</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Standard">Charge the camera</text:p></text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Results</text:h>
   <table:table table:name="Results" table:style-name="Tbl">
    <table:table-column table:style-name="Tbl.A" table:number-columns-repeated="3"/>
    <table:table-row><table:table-cell table:style-name="Tbl.H" table:number-columns-spanned="3"><text:p text:style-name="P2">Counts by region</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Tbl.H"><text:p>Region</text:p></table:table-cell><table:table-cell table:style-name="Tbl.H"><text:p>Morning</text:p></table:table-cell><table:table-cell table:style-name="Tbl.H"><text:p>Evening</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Tbl.C" table:number-rows-spanned="2"><text:p>North</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>42</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>37</text:p></table:table-cell></table:table-row>
    <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Tbl.C"><text:p>40</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>35</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Tbl.C"><text:p>South</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>28</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>31</text:p></table:table-cell></table:table-row>
   </table:table>
   <text:p text:style-name="P2"><draw:frame draw:style-name="fr1" draw:name="Chart" text:anchor-type="as-char" svg:width="2.5in" svg:height="1.25in"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>Bar chart of the counts</svg:desc></draw:frame></text:p>
   <text:p text:style-name="P1">현장 기록: 북부 지역의 아침 집계가 가장 많았다.</text:p>
   <text:p text:style-name="Standard">The last page closes the notes.</text:p>
  </office:text>
 </office:body>
