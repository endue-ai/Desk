 <office:body>
  <office:text>
   <text:tracked-changes>
    <text:changed-region xml:id="ct1" text:id="ct1"><text:deletion><office:change-info><dc:creator>Mina Park</dc:creator><dc:date>2026-10-21T09:00:00</dc:date></office:change-info><text:p>removed words </text:p></text:deletion></text:changed-region>
    <text:changed-region xml:id="ct3" text:id="ct3"><text:deletion><office:change-info><dc:creator>Mina Park</dc:creator><dc:date>2026-10-21T09:10:00</dc:date></office:change-info><text:p>was cut here.</text:p><text:p>Removed lead-in </text:p></text:deletion></text:changed-region>
    <text:changed-region xml:id="ct2" text:id="ct2"><text:insertion><office:change-info><dc:creator>Mina Park</dc:creator><dc:date>2026-10-21T09:05:00</dc:date></office:change-info></text:insertion></text:changed-region>
   </text:tracked-changes>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Format check</text:h>
   <text:p text:style-name="Standard">This line has <text:span text:style-name="T1">a bold red 14 pt run</text:span>, <text:span text:style-name="T2">italic underlined words</text:span>, <text:span text:style-name="T3">a highlight</text:span>, <text:span text:style-name="T4">struck text</text:span>, x<text:span text:style-name="T5">2</text:span> and H<text:span text:style-name="T6">2</text:span>O, <text:span text:style-name="T7">mono blue</text:span> and <text:span text:style-name="T8">small caps</text:span>.</text:p>
   <text:p text:style-name="P1">A centred paragraph.</text:p>
   <text:p text:style-name="P2">A paragraph on the right.</text:p>
   <text:p text:style-name="Quote">A quoted paragraph, justified, indented half an inch on both sides with a quarter-inch first line and one and a half lines of spacing, long enough to wrap onto a second line.</text:p>
   <text:p text:style-name="P5">Exact spacing: a quarter inch before and after.</text:p>
   <text:p text:style-name="Standard">Kept text <text:change text:change-id="ct1"/>stays, and <text:change-start text:change-id="ct2"/>inserted words<text:change-end text:change-id="ct2"/> show.</text:p>
   <text:p text:style-name="Standard">Joined: first half <text:change text:change-id="ct3"/>and second half.</text:p>
   <text:p text:style-name="Standard">See <text:a xlink:type="simple" xlink:href="https://example.com/format">the format page</text:a> and write to <text:a xlink:type="simple" xlink:href="mailto:desk@example.com">the desk</text:a>.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">A footnote about the format.</text:p></text:note-body></text:note> The end has a note too.<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Footnote">An endnote at the end.</text:p></text:note-body></text:note></text:p>
   <text:p text:style-name="Standard">The <office:annotation office:name="c1"><dc:creator>Mina Park</dc:creator><dc:date>2026-10-20T10:30:00</dc:date><text:p>Check the totals.</text:p></office:annotation>reviewed numbers<office:annotation-end office:name="c1"/> stand.</text:p>
   <text:h text:style-name="Heading_20_2" text:outline-level="2">Lists</text:h>
   <text:list text:style-name="Numbering_20_123">
    <text:list-item><text:p text:style-name="Standard">First step</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Standard">Second step</text:p>
     <text:list><text:list-item><text:p text:style-name="Standard">Inner one</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">Inner two</text:p></text:list-item></text:list>
    </text:list-item>
    <text:list-item><text:p text:style-name="Standard">Third step</text:p></text:list-item>
   </text:list>
   <text:list text:style-name="List_20_1">
    <text:list-item><text:p text:style-name="Standard">A bullet</text:p></text:list-item>
    <text:list-item><text:p text:style-name="Standard">Another bullet</text:p></text:list-item>
   </text:list>
   <text:h text:style-name="Heading_20_3" text:outline-level="3">Table</text:h>
   <table:table table:name="Counts" table:style-name="Tbl">
    <table:table-column table:style-name="Tbl.A"/>
    <table:table-column table:style-name="Tbl.B" table:number-columns-repeated="2"/>
    <table:table-row><table:table-cell table:style-name="Tbl.H" table:number-columns-spanned="3"><text:p text:style-name="P1">Counts by site</text:p></table:table-cell><table:covered-table-cell/><table:covered-table-cell/></table:table-row>
    <table:table-row><table:table-cell table:style-name="Tbl.H"><text:p>Site</text:p></table:table-cell><table:table-cell table:style-name="Tbl.H"><text:p>Morning</text:p></table:table-cell><table:table-cell table:style-name="Tbl.H"><text:p>Evening</text:p></table:table-cell></table:table-row>
    <table:table-row><table:table-cell table:style-name="Tbl.C" table:number-rows-spanned="2"><text:p>East</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>12</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>9</text:p></table:table-cell></table:table-row>
    <table:table-row><table:covered-table-cell/><table:table-cell table:style-name="Tbl.C"><text:p>14</text:p></table:table-cell><table:table-cell table:style-name="Tbl.C"><text:p>11</text:p></table:table-cell></table:table-row>
   </table:table>
   <text:p text:style-name="P1"><draw:frame draw:style-name="fr1" draw:name="Chart" text:anchor-type="as-char" svg:width="1.25in" svg:height="0.625in"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAHgAAAA8CAIAAAAiz+n/AAAAl0lEQVR42u3c0QmAMAxAwVQcpGs4kFN1INfoJnEJlVDvDVDKEfoRxJaZoffbEIAGLdCgQQs0aIGu2l7nKv04nzpqXsNEezoEGrRAgwYt0KAFGjRoxR+WSrH0AstEezpACzRo0AhAgxZo0KAVBXYda3/UYqJBCzRogQYNWqBBCzRo0AINWqBBgxZo0AL9Vc1/70w0aIEu2w0ZHA93bgd4aAAAAABJRU5ErkJggg==</office:binary-data></draw:image><svg:desc>A small chart</svg:desc></draw:frame> <draw:frame draw:style-name="fr1" draw:name="Photo" text:anchor-type="as-char" svg:width="0.89in" svg:height="0.44in"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>A photo</svg:desc></draw:frame> <draw:frame draw:style-name="fr1" draw:name="Shape" text:anchor-type="as-char" svg:width="1.39in" svg:height="0.69in"><draw:image><office:binary-data>183GmgAAAAAAANAH6AOgBQAAAACJVgEACQAAAygAAAABAAcAAAAAAAUAAAALAgAAAAAFAAAADALoA9AHBwAAAPwCAABkOB8AAAAEAAAALQEAAAcAAAAbBIQDbAdkAGQAAwAAAAAA</office:binary-data></draw:image><svg:desc>A drawing</svg:desc></draw:frame></text:p>
   <text:p text:style-name="Standard">A text box follows this paragraph.<draw:frame draw:style-name="fr2" draw:name="Box" text:anchor-type="paragraph" svg:x="4in" svg:y="0in" svg:width="2in" svg:height="0.6in"><draw:text-box><text:p text:style-name="Standard">Boxed note text.</text:p></draw:text-box></draw:frame></text:p>
   <text:p text:style-name="P3">한글 문단: 두 번째 페이지가 여기서 시작한다.</text:p>
   <text:p text:style-name="P4">The Letter section starts here.</text:p>
   <text:section text:style-name="Sect1" text:name="Columns">
    <text:p text:style-name="Standard">Two columns of text become one column in the page view. This paragraph is long enough to fill a little of both columns when a word processor lays it out.</text:p>
   </text:section>
   <text:p text:style-name="Standard">The last paragraph.</text:p>
  </office:text>
 </office:body>
