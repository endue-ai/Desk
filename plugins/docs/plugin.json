{
  "id": "endue.docs",
  "name": "Docs",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens word-processor documents (Word, Pages, OpenDocument, RTF, Hangul, AbiWord, WordPerfect, Works) in one page view with an outline, comments and find. It reads; it does not edit.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "shell:open",
      "schemes": ["http", "https", "mailto"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Docs",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.docx",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.docm",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.dotx",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.dotm",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.doc",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.dot",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.odt",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.ott",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.fodt",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.sxw",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.rtf",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.pages",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.hwp",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.hwpx",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.abw",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.wpd",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.wps",
        "plugin": "endue.docs"
      },
      {
        "pattern": "*.gdoc",
        "plugin": "endue.docs"
      }
    ],
    "commands": [
      {
        "id": "endue.docs.read",
        "title": "Docs: the open document as text",
        "keywords": ["docs", "document", "read", "word", "docx", "odt", "rtf", "text"],
        "description": "The document on screen in Docs, or the open one named by path, as plain text: headings marked with #, list items with their marker, table rows with | between cells, then its footnotes, endnotes and comments. from and chars (20000, at most 200000) read a part of a long one; length and more say how much there is. documents lists every document Docs has open. It leaves the screen as it is. Docs reads only what the desk opened in it: open a file with desk.files.open first.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "text": {
              "type": ["string", "null"]
            },
            "length": {
              "type": "integer"
            },
            "more": {
              "type": "boolean"
            },
            "documents": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
