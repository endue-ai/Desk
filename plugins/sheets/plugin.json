{
  "id": "endue.sheets",
  "name": "Sheets",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens every spreadsheet in one grid: Excel, Numbers, OpenDocument, CSV and the older formats, with sheet tabs, a formula bar, find and the selection's sum. Edits CSV and TSV cells and saves only their bytes; the rest it reads.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed", "desk.buffers.update"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "fs:write",
      "paths": ["/**"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Sheets",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.xlsx",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xlsm",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xlsb",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xls",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xlt",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xltx",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xltm",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.ods",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.ots",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.fods",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.numbers",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.csv",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.tsv",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.dif",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.slk",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.sylk",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wk1",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wk3",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wk4",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wks",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.123",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.qpw",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.gsheet",
        "plugin": "endue.sheets"
      }
    ],
    "settings": {
      "endue.sheets.csv-encoding": {
        "kind": "string",
        "default": "auto",
        "choices": ["auto", "utf-8", "euc-kr", "shift_jis", "windows-1252"],
        "description": "The encoding of CSV and TSV files. auto: a byte order mark (UTF-8 or UTF-16), then UTF-8, and EUC-KR (code page 949) when the bytes are not UTF-8."
      }
    },
    "commands": [
      {
        "id": "endue.sheets.select",
        "title": "Sheets: Select a range",
        "description": "Select an A1 range in the active worksheet or in a named worksheet of the open file.",
        "args": {
          "type": "object",
          "properties": {
            "sheet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "range": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "additionalProperties": false,
          "required": ["range"]
        },
        "agent": true
      },
      {
        "id": "endue.sheets.find",
        "title": "Sheets: Find cells",
        "description": "Find a cell in the current worksheet and move the active cell to it. Repeat the same text to advance to its next match.",
        "args": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "additionalProperties": false,
          "required": ["text"]
        },
        "agent": true
      },
      {
        "id": "endue.sheets.edit",
        "title": "Sheets: Edit cells",
        "description": "Set a rectangular A1 range in the current worksheet using exact cell text. Every value must fit the range and the file format. The edits stay unsaved until Save.",
        "args": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 20000
                }
              }
            }
          },
          "additionalProperties": false,
          "required": ["range", "values"]
        },
        "agent": true
      },
      {
        "id": "endue.sheets.save",
        "title": "Sheets: Save edits",
        "description": "Save the edits in the open worksheet at its exact path from endue.sheets.read. The desk uses the file's write grant and version history to decide whether review is needed.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "additionalProperties": false,
          "required": ["path"]
        },
        "agent": true
      },
      {
        "id": "endue.sheets.read",
        "title": "Sheets: a range of the open spreadsheet as data",
        "keywords": ["sheets", "spreadsheet", "excel", "csv", "cells", "read", "range"],
        "description": "Read cell text in the open workbook, defaulting to the worksheet on screen. Give sheet to read another worksheet, path for another open workbook, or range for an A1 range. The answer includes selection, active cell, unsaved changes and available sheets. Use formulas true to include formulas by address.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sheet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "range": {
              "type": "string",
              "pattern": "^\\s*[A-Za-z]{1,3}\\d{1,7}(:[A-Za-z]{1,3}\\d{1,7})?\\s*$"
            },
            "formulas": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sheet": {
              "type": "string"
            },
            "range": {
              "type": ["string", "null"]
            },
            "values": {
              "type": ["array", "null"]
            },
            "sheets": {
              "type": "array"
            },
            "more": {
              "type": "boolean"
            },
            "unsaved": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
