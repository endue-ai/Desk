{
  "id": "endue.sheets",
  "name": "Sheets",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens every spreadsheet in one grid: Excel, Numbers, OpenDocument, CSV and the older formats, with sheet tabs, a formula bar, find and the selection's sum. Edits CSV and TSV cells and saves only their bytes; the rest it reads.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed", "desk.buffers.update"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "fs:write",
      "paths": ["/**"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Sheets",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.xlsx",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xlsm",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xlsb",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xls",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xlt",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xltx",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.xltm",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.ods",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.ots",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.fods",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.numbers",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.csv",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.tsv",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.dif",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.slk",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.sylk",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wk1",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wk3",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wk4",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.wks",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.123",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.qpw",
        "plugin": "endue.sheets"
      },
      {
        "pattern": "*.gsheet",
        "plugin": "endue.sheets"
      }
    ],
    "settings": {
      "endue.sheets.csv-encoding": {
        "kind": "string",
        "default": "auto",
        "choices": ["auto", "utf-8", "euc-kr", "shift_jis", "windows-1252"],
        "description": "The encoding of CSV and TSV files. auto: a byte order mark (UTF-8 or UTF-16), then UTF-8, and EUC-KR (code page 949) when the bytes are not UTF-8."
      }
    },
    "commands": [
      {
        "id": "endue.sheets.read",
        "title": "Sheets: a range of the open spreadsheet as data",
        "keywords": ["sheets", "spreadsheet", "excel", "csv", "cells", "read", "range"],
        "description": "Cells of the spreadsheet on screen in Sheets, or the open one named by path, as the text each shows: range is A1 or A1:D20 (without it, the filled part from A1 up to 50 rows and 26 columns), on sheet (the first without it), at most 500 rows and 50 columns a read; more says the sheet goes on. formulas true adds each formula by address. Answers values row by row, the range read, every sheet with how many rows and columns it fills, the files Sheets has open and whether this one has unsaved edits. It leaves the screen as it is. Sheets reads only what the desk opened in it: open a file with desk.files.open first.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sheet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "range": {
              "type": "string",
              "pattern": "^\\s*[A-Za-z]{1,3}\\d{1,7}(:[A-Za-z]{1,3}\\d{1,7})?\\s*$"
            },
            "formulas": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sheet": {
              "type": "string"
            },
            "range": {
              "type": ["string", "null"]
            },
            "values": {
              "type": ["array", "null"]
            },
            "sheets": {
              "type": "array"
            },
            "more": {
              "type": "boolean"
            },
            "unsaved": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
