{
  "id": "endue.screens",
  "name": "Screen Sharing",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "permissions": [
    {
      "permission": "net:connect",
      "hosts": ["*"]
    }
  ],
  "autoload": true,
  "description": "Another computer's screen in a desk window over VNC, the protocol macOS Screen Sharing speaks: see it, use its keyboard and pointer, or only watch. The connection is the core's (net.connect), asked for once per computer; passwords are asked each time and never kept.",
  "surfaces": [
    {
      "id": "main",
      "title": "Screen Sharing",
      "placement": "center"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.screens.open",
        "title": "Screen Sharing: Show the computers",
        "keywords": ["screen sharing", "vnc", "remote", "mac", "화면 공유"],
        "runs": {
          "command": "desk.plugins.open",
          "args": {
            "plugin": "endue.screens"
          }
        }
      },
      {
        "id": "endue.screens.connect",
        "title": "Screen Sharing: Connect to a computer",
        "keywords": ["screen sharing", "vnc", "remote", "connect", "화면 공유"],
        "description": "Connect to a saved computer by id or exact host for an agent. From the desk, a host can be added or a form opened.",
        "args": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "A saved computer's id"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.screens.disconnect",
        "title": "Screen Sharing: Disconnect",
        "keywords": ["screen sharing", "vnc", "disconnect"],
        "agent": true,
        "description": "End the current Screen Sharing session.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "id": "endue.screens.computers",
        "title": "Screen Sharing: Read the saved computers",
        "description": "List saved computer ids, names and addresses.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.screens.state",
        "title": "Screen Sharing: Read the current session",
        "description": "Read the current session phase, saved computer and display controls.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.screens.view-only",
        "title": "Screen Sharing: Set view-only mode",
        "description": "Set view-only mode with on, or toggle it when omitted.",
        "args": {
          "type": "object",
          "properties": {
            "on": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.screens.fit",
        "title": "Screen Sharing: Fit the remote screen",
        "description": "Set fit mode with on, or toggle it when omitted.",
        "args": {
          "type": "object",
          "properties": {
            "on": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      }
    ]
  }
}
