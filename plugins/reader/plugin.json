{
  "id": "endue.reader",
  "name": "Reader",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Opens PDFs, XPS, e-books (EPUB, MOBI, AZW, FB2), comics (CBZ, CBT, CBR, CB7) and DjVu books in one reader: pages, contents, bookmarks, search and notes. It reads; it never writes the file.",
  "permissions": [
    {
      "permission": "cmd:invoke",
      "ids": ["desk.files.changed"]
    },
    {
      "permission": "fs:read",
      "paths": ["/**"]
    },
    {
      "permission": "shell:open",
      "schemes": ["http", "https", "mailto"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Reader",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.pdf",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.xps",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.oxps",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.epub",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.mobi",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.azw",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.azw3",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.prc",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.fb2",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.cbz",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.cbt",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.cbr",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.cb7",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.djvu",
        "plugin": "endue.reader"
      },
      {
        "pattern": "*.djv",
        "plugin": "endue.reader"
      }
    ],
    "commands": [
      {
        "id": "endue.reader.read",
        "title": "Reader: the open book as text",
        "keywords": ["reader", "pdf", "epub", "book", "read", "pages", "chapters"],
        "description": "The text of the book on screen in Reader, or the open one named by path: count pages (PDF, XPS, DjVu, comics) or chapters (EPUB, MOBI, FB2) from from (1 is the first; 5 by default, at most 50, 100000 characters at most), each with its number and a chapter its title. From the first one it adds the contents (title, where it starts, depth). more says the book goes on; books lists every book Reader has open. It leaves the screen and the reading place as they are. A locked book waits for the person to type its password. Reader reads only what the desk opened in it: open a file with desk.files.open first.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "from": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "units": {
              "type": "integer"
            },
            "pages": {
              "type": "array"
            },
            "chapters": {
              "type": "array"
            },
            "contents": {
              "type": "array"
            },
            "more": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.reader.find",
        "title": "Reader: find words in the open book",
        "keywords": ["reader", "find", "search", "pdf", "book"],
        "description": "The pages or chapters of the book on screen in Reader (or the open one named by path) whose text holds query, any case, each with its number and the words around the first match, up to 50. It leaves the screen as it is; read one with endue.reader.read from that number.",
        "args": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "found": {
              "type": "array"
            },
            "more": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      }
    ]
  }
}
