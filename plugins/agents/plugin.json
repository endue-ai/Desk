{
  "id": "endue.agents",
  "name": "Agents",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "autoload": true,
  "description": "Every agent as a card: your endue AI agents and the agent programs on this computer, in one Home, one Studio and New agent, with a chat to local agents.",
  "permissions": [
    {
      "permission": "studio:manage"
    },
    {
      "permission": "agents:manage"
    },
    {
      "permission": "shell:open",
      "schemes": ["https"]
    },
    {
      "permission": "cmd:invoke",
      "ids": ["desk.account.sign-in"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Agents",
      "placement": "center"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.agents.open",
        "title": "Agents: Home",
        "description": "Open the Agents home for the person.",
        "args": { "type": "object" },
        "agent": true,
        "keywords": ["agents", "studio", "endue", "claude", "codex", "cards"],
        "runs": {
          "command": "desk.plugins.open",
          "args": {
            "plugin": "endue.agents"
          }
        }
      },
      {
        "id": "endue.agents.new",
        "title": "Agents: New agent",
        "keywords": ["agent", "new", "create", "새 에이전트"],
        "description": "Show the New agent page for the person.",
        "agent": true,
        "args": { "type": "object", "additionalProperties": false }
      },
      {
        "id": "endue.agents.studio",
        "title": "Agents: Studio",
        "keywords": ["agent", "studio", "edit", "스튜디오"],
        "description": "Show an endue agent's Studio using its ID from endue.agents.list. Give a facet to open its inspector.",
        "agent": true,
        "args": {
          "type": "object",
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "facet": { "type": "string" }
          },
          "required": ["agent"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.agents.list",
        "title": "List endue agents",
        "description": "List the person's endue Studio agents by ID, name, slug and status.",
        "agent": true,
        "readOnly": true,
        "args": { "type": "object", "additionalProperties": false }
      }
    ]
  }
}
