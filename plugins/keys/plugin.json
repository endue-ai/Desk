{
  "id": "desk.keys",
  "name": "Keys",
  "version": "0.1.0",
  "kind": "policy",
  "description": "The default keymap: which key runs which command. Mod is Command on macOS and Control elsewhere.",
  "contributes": {
    "keys": [
      {
        "key": "Mod+K",
        "command": "desk.palette.open"
      },
      {
        "key": "Mod+Shift+P",
        "command": "desk.palette.open"
      },
      {
        "key": "Escape",
        "command": "desk.keys.quit"
      },
      {
        "key": "Mod+/",
        "command": "desk.keys.list"
      },
      {
        "key": "Mod+B",
        "command": "desk.buffers.switch"
      },
      {
        "key": "Mod+W",
        "command": "desk.buffers.close"
      },
      {
        "key": "Mod+Alt+ArrowRight",
        "command": "desk.buffers.next"
      },
      {
        "key": "Mod+Alt+ArrowLeft",
        "command": "desk.buffers.previous"
      },
      {
        "key": "Control+Tab",
        "command": "desk.display.focus-next"
      },
      {
        "key": "Control+Shift+Tab",
        "command": "desk.display.focus-previous"
      },
      {
        "key": "Mod+O",
        "command": "desk.files.open"
      },
      {
        "key": "Mod+S",
        "command": "desk.files.save"
      },
      {
        "key": "Mod+Shift+O",
        "command": "desk.files.recent"
      },
      {
        "key": "Mod+Shift+L",
        "command": "desk.theme.toggle"
      },
      {
        "key": "Mod+Shift+N",
        "command": "desk.notify.history"
      },
      {
        "key": "Mod+Shift+D",
        "command": "desk.notify.dnd"
      },
      {
        "key": "Mod+Shift+M",
        "command": "desk.profiles.switch"
      },
      {
        "key": "Mod+N",
        "command": "desk.display.new-surface"
      },
      {
        "key": "Mod+D",
        "command": "desk.display.split-right"
      },
      {
        "key": "Mod+Alt+D",
        "command": "desk.display.split-down"
      },
      {
        "key": "Mod+]",
        "command": "desk.display.focus-next"
      },
      {
        "key": "Mod+[",
        "command": "desk.display.focus-previous"
      },
      {
        "key": "Control+1",
        "command": "desk.shell.desktop-1"
      },
      {
        "key": "Control+2",
        "command": "desk.shell.desktop-2"
      },
      {
        "key": "Control+3",
        "command": "desk.shell.desktop-3"
      },
      {
        "key": "Control+4",
        "command": "desk.shell.desktop-4"
      }
    ],
    "settings": {
      "desk.keys.bindings": {
        "kind": "array",
        "default": [],
        "description": "The person's own bindings, layered over every plugin's: { key, command }, and \"command\": \"\" takes a key away. A rebinding screen writes them; desk.session keeps them."
      }
    }
  }
}
