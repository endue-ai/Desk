          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "[ip:][host:]container[/proto]"
            },
            "env": {
              "description": "KEY=value lines or an object"
            },
            "volumes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "source:target[:options]"
            },
            "restart": {
              "type": "string"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["image"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.docker.pull",
        "title": "Docker: pull an image",
        "keywords": ["download", "update"],
