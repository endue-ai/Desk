        "agent": true
      },
      {
        "id": "endue.docker.kill",
        "title": "Docker: kill the container",
        "keywords": ["sigkill"],
        "irreversible": true,
        "description": "Kill a container's processes at once. Asks first.",
        "args": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            },
            "containers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Several containers' names or ids; the answer says which worked and which failed"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.docker.remove",
        "title": "Docker: remove the container",
        "keywords": ["rm", "delete"],
        "irreversible": true,
        "description": "Remove a container (or several), stopping it first when it runs. Asks first.",
        "args": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            },
            "containers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Several containers' names or ids; the answer says which worked and which failed"
            },
            "volumes": {
              "type": "boolean",
              "description": "Also remove its anonymous volumes"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.docker.logs",
        "title": "Docker: logs",
        "keywords": ["tail", "follow", "output"],
        "description": "Show a container's or project's logs, following them unless follow is false.",
        "args": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            },
            "project": {
              "type": "string",
              "description": "A Compose project's name"
            },
            "follow": {
              "type": "boolean"
            },
            "tail": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "endue.docker.tail",
        "title": "Docker: read the last log lines",
        "keywords": ["logs", "read"],
        "description": "Return a container's or project's last log lines (both streams, in time order) without showing them.",
        "args": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            },
            "project": {
              "type": "string",
              "description": "A Compose project's name"
            },
            "tail": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "since": {
              "type": "string",
              "description": "A duration (10m) or a time (RFC 3339)"
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.docker.inspect",
        "title": "Docker: container detail",
        "keywords": ["inspect", "env", "mounts"],
        "description": "Show and return a container's state, health, ports, mounts, networks, environment (secrets masked), labels and limits.",
        "args": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.docker.stats",
