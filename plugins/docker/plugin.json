{
  "id": "endue.docker",
  "name": "Docker",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "Containers, Compose stacks, images, volumes and networks of the engine the docker program reaches: an overview first, dense lists with live resource use, marks for bulk actions, a detail pane with logs, stats, files and the inspect tree, image history, pulls and builds with progress, every operation a command that runs docker without a shell.",
  "permissions": [
    {
      "permission": "proc:spawn",
      "commands": ["docker"]
    },
    {
      "permission": "cmd:invoke",
      "ids": [
        "desk.palette.pick",
        "desk.buffers.open",
        "desk.buffers.update",
        "desk.files.open",
        "endue.terminal.run"
      ]
    },
    {
      "permission": "ui:notify"
    },
    {
      "permission": "shell:open",
      "schemes": ["http", "https"]
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Docker",
      "placement": "center"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.docker.open",
        "title": "Docker: open",
        "keywords": ["containers", "whale", "engine"],
        "description": "Show the Docker surface, on a list when view names one.",
        "args": {
          "type": "object",
          "properties": {
            "view": {
              "enum": [
                "overview",
                "containers",
                "compose",
                "images",
                "volumes",
                "networks",
                "system"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "endue.docker.refresh",
        "title": "Docker: refresh",
        "keywords": ["reload"],
        "description": "Read what is on screen again.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "id": "endue.docker.containers",
        "title": "Docker: containers",
        "keywords": ["ps", "list"],
        "description": "Show and return the containers (all, or only running ones with all: false), with resource use when sampled.",
        "args": {
          "type": "object",
          "properties": {
            "all": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.docker.compose",
