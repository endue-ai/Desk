        "args": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The program and its arguments; the shell setting when absent"
