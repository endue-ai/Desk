          "properties": {
            "container": {
              "type": "string",
              "description": "A container's name or id"
            },
            "containers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Several containers' names or ids; the answer says which worked and which failed"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.docker.restart",
