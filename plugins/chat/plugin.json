{
  "id": "endue.chat",
  "name": "Chat",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "Every chat service the desk's connectors bring in (Slack, Discord, Microsoft Teams, Telegram, Matrix and others) in one interface: conversations by service and workspace, threads, reactions and replies, in four layouts (Conversation, Inbox, Timeline, Columns), acting through each connector's commands.",
  "permissions": [
    {
      "permission": "data:read",
      "kinds": ["message"]
    },
    {
      "permission": "cmd:invoke",
      "ids": [
        "*.chat.send",
        "*.chat.react",
        "*.chat.read",
        "*.chat.edit",
        "*.chat.delete",
        "desk.palette.pick",
        "desk.connectors.open"
      ]
    },
    {
      "permission": "ui:notify"
    },
    {
      "permission": "shell:open",
      "schemes": ["http", "https", "mailto"]
    },
    {
      "permission": "connector:manage"
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Chat",
      "placement": "center"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.chat.open",
        "title": "Show chats",
        "keywords": ["chat", "slack", "discord", "teams", "messages", "dm"]
      },
      {
        "id": "endue.chat.show",
        "title": "Show a chat message in its conversation",
        "keywords": ["chat", "message", "open"],
        "description": "Open a message in the chat plugin, in its conversation or thread, and bring the window up. The message is { source, id } as endue.chat.messages and find-messages answer them.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.conversation",
        "title": "Go to a chat conversation",
        "keywords": ["chat", "channel", "dm", "conversation", "switch"],
        "description": "Open a conversation in the chat plugin and bring the window up with its composer. The conversation is { source, channel } as endue.chat.conversations answers them.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "conversation": {
              "type": "string",
              "maxLength": 2000,
              "description": "A conversation's key, instead of source and channel."
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.layout",
        "title": "Switch the chat layout",
        "keywords": ["chat", "view", "layout", "inbox", "timeline", "columns"],
        "description": "Show the conversation, inbox, timeline or columns layout. Omit layout to cycle.",
        "args": {
          "type": "object",
          "properties": {
            "layout": { "type": "string", "enum": ["conversation", "inbox", "timeline", "columns"] }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.filter",
        "title": "Filter chats",
        "keywords": ["chat", "unread", "mentions", "direct", "saved"],
        "description": "Show all chats, unread, mentions, direct messages or saved messages.",
        "args": {
          "type": "object",
          "properties": {
            "filter": { "type": "string", "enum": ["all", "unread", "mentions", "direct", "saved"] }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.platform",
        "title": "Show one chat service",
        "keywords": ["chat", "slack", "discord", "teams", "service"],
        "description": "Show a chat service by id, such as slack or discord. Use all to clear the service filter.",
        "args": {
          "type": "object",
          "properties": { "platform": { "type": "string", "maxLength": 100 } },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.search",
        "title": "Search every chat",
        "keywords": ["chat", "find", "search"],
        "description": "Show matching chats in the timeline. Pass empty text to clear the search.",
        "args": {
          "type": "object",
          "properties": { "text": { "type": "string", "maxLength": 500 } },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.refresh",
        "title": "Refresh chats",
        "keywords": ["chat", "reload", "sync"],
        "description": "Read the chat accounts' conversations again from the index.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.next-unread",
        "title": "Go to the next unread conversation",
        "keywords": ["chat", "unread", "next"],
        "description": "Open the next unread conversation in the current chat view, wrapping at the end.",
        "args": { "type": "object", "properties": {}, "additionalProperties": false },
        "agent": true
      },
      {
        "id": "endue.chat.draft",
        "title": "Prepare a chat draft",
        "keywords": ["chat", "draft", "write", "composer"],
        "description": "Prepare text in the named conversation's composer for the person to review and send. Name source and channel as conversations answers them, and optionally a thread root id in that conversation. An existing draft with different text stays in the composer.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": { "connector": { "type": "string" }, "instance": { "type": "string" } },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "channel": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "thread": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "text": { "type": "string", "minLength": 1, "maxLength": 40000 }
          },
          "required": ["source", "channel", "text"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.send",
        "title": "Send a chat message",
        "keywords": ["chat", "send", "message", "post"],
        "irreversible": true,
        "description": "Send text to a conversation, or as a reply in the thread whose root id is thread, after the person says yes. The conversation is { source, channel } as endue.chat.conversations answers them. Answers the sent message's id.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "conversation": {
              "type": "string",
              "maxLength": 2000,
              "description": "A conversation's key, instead of source and channel."
            },
            "thread": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40000
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.reply",
        "title": "Reply in the selected message's thread",
        "keywords": ["chat", "reply", "thread"]
      },
      {
        "id": "endue.chat.react",
        "title": "React to the selected message",
        "keywords": ["chat", "react", "emoji", "reaction"],
        "description": "React to the message { source, id } with emoji (the character or :name:). Set on true to add the reaction or false to remove it. Omit on to toggle. Answers whether the reaction is present.",
        "irreversible": true,
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "emoji": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "on": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.edit",
        "title": "Edit your chat message",
        "keywords": ["chat", "edit", "change"],
        "irreversible": true,
        "description": "Change the text of one of the person's own messages to text. The message is { source, id } as endue.chat.messages and find-messages answer them.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40000
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.delete",
        "title": "Delete your chat message",
        "keywords": ["chat", "delete", "remove"],
        "irreversible": true,
        "description": "Delete one of the person's own messages after the desk asks for approval. Name the message by { source, id } as endue.chat.messages and find-messages answer them.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "confirmed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.mark-read",
        "title": "Mark the conversation read",
        "keywords": ["chat", "read", "seen"],
        "description": "Mark every message of a conversation read. The conversation is { source, channel } as endue.chat.conversations answers them. Answers how many were unread.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "conversation": {
              "type": "string",
              "maxLength": 2000,
              "description": "A conversation's key, instead of source and channel."
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.mark-all-read",
        "title": "Mark every chat read",
        "keywords": ["chat", "read", "all", "clear"],
        "description": "Mark every unread conversation in the current view read. Give a platform id to cover that service, or all to cover every service. Answers how many messages changed.",
        "args": {
          "type": "object",
          "properties": { "platform": { "type": "string", "maxLength": 100 } },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.save",
        "title": "Save the selected message for later",
        "keywords": ["chat", "save", "bookmark", "later", "star"],
        "description": "Save a message to the person's Saved list, or take it off when it is there. The message is { source, id } as endue.chat.messages and find-messages answer them. Answers whether it is saved now.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.pin",
        "title": "Pin the conversation as a column",
        "keywords": ["chat", "pin", "column", "deck"],
        "description": "Pin a conversation as a column in the Columns layout, or unpin it. The conversation is { source, channel } as endue.chat.conversations answers them. Answers whether it is pinned now.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "conversation": {
              "type": "string",
              "maxLength": 2000,
              "description": "A conversation's key, instead of source and channel."
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.chat.find",
        "title": "Find chat conversations",
        "keywords": ["chat", "find"]
      },
      {
        "id": "endue.chat.conversations",
        "title": "Chat: conversations as data",
        "keywords": ["chat", "conversations", "channels", "unread", "dm"],
        "description": "The chat accounts' conversations, newest activity first, as data, leaving the screen as it is: each with source and channel (to read, open or send to it), name, kind (channel, private, dm or group), platform, workspace, unread, mentions and its latest message. platform narrows to one service (slack, discord, teams…), unread true to those with unread messages, query to names holding the words. Up to limit (30, at most 200); unread counts them all.",
        "args": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "maxLength": 100
            },
            "unread": {
              "type": "boolean"
            },
            "query": {
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "conversations": {
              "type": "array"
            },
            "unread": {
              "type": "integer"
            },
            "more": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.chat.current",
        "title": "Chat: read the open view",
        "keywords": ["chat", "current", "layout", "selection", "thread"],
        "description": "Read the layout, filter, platform, search, open conversation, thread root and message selection. Unset targets are null.",
        "args": { "type": "object", "properties": {}, "additionalProperties": false },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.chat.messages",
        "title": "Chat: a conversation's messages as data",
        "keywords": ["chat", "messages", "read", "history", "thread"],
        "description": "A conversation's newest messages, oldest first, as data, leaving the screen as it is and marking nothing read: each with source and id, author, self (the person's own), at, text (to 4000 characters), unread, thread, isReply, replyCount, reactions and attachments. thread, a root message's id, answers that thread's root and its replies instead. Use { source, channel } as endue.chat.conversations answers them, or omit the target for the open conversation. Up to limit (20, at most 100).",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "conversation": {
              "type": "string",
              "maxLength": 2000,
              "description": "A conversation's key, instead of source and channel."
            },
            "thread": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "connector": {
                        "type": "string"
                      },
                      "instance": {
                        "type": "string"
                      }
                    },
                    "required": ["connector", "instance"],
                    "additionalProperties": false
                  },
                  "id": {
                    "type": "string"
                  },
                  "channel": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  },
                  "self": {
                    "type": "boolean"
                  },
                  "at": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "unread": {
                    "type": "boolean"
                  },
                  "thread": {
                    "type": "string"
                  },
                  "isReply": {
                    "type": "boolean"
                  },
                  "replyCount": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.chat.find-messages",
        "title": "Chat: find messages as data",
        "keywords": ["chat", "find", "search", "messages"],
        "description": "Find chat messages by text across accounts, newest first, as data, up to limit (20, at most 100). Use saved true for the person's saved messages, with optional text to filter them. Leaves the screen as it is.",
        "args": {
          "type": "object",
          "properties": {
            "saved": { "type": "boolean" },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "connector": {
                        "type": "string"
                      },
                      "instance": {
                        "type": "string"
                      }
                    },
                    "required": ["connector", "instance"],
                    "additionalProperties": false
                  },
                  "id": {
                    "type": "string"
                  },
                  "channel": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  },
                  "self": {
                    "type": "boolean"
                  },
                  "at": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "unread": {
                    "type": "boolean"
                  },
                  "thread": {
                    "type": "string"
                  },
                  "isReply": {
                    "type": "boolean"
                  },
                  "replyCount": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.chat.connect",
        "title": "Connect a chat account",
        "keywords": ["chat", "connect", "account", "slack", "discord", "connector"]
      }
    ],
    "keys": [
      {
        "key": "Mod+Shift+J",
        "command": "endue.chat.open"
      }
    ],
    "paletteProviders": [
      {
        "command": "endue.chat.find",
        "title": "Chats"
      }
    ],
    "settings": {
      "endue.chat.page": {
        "kind": "integer",
        "default": 100,
        "minimum": 1,
        "maximum": 500,
        "description": "How many messages a conversation and the Timeline read at a time; Load earlier reads the next page."
      },
      "endue.chat.notify": {
        "kind": "string",
        "default": "mentions",
        "choices": ["mentions", "all", "none"],
        "description": "Which new messages show a notification: direct messages and mentions, every message, or none."
      },
      "endue.chat.mark-read": {
        "kind": "string",
        "default": "open",
        "choices": ["open", "never"],
        "description": "When a conversation is marked read: when it opens, or never by itself."
      },
      "endue.chat.enter-sends": {
        "kind": "boolean",
        "default": true,
        "description": "Enter sends and Shift+Enter starts a new line; off, Mod+Enter sends."
      },
      "endue.chat.density": {
        "kind": "string",
        "default": "comfortable",
        "choices": ["comfortable", "compact"],
        "description": "How much room each message takes."
      },
      "endue.chat.quick-reactions": {
        "kind": "array",
        "default": [],
        "description": "Up to six emoji (or :names:) a message offers with one click; empty uses 👍 ❤️ 😂 🎉 👀 ✅."
      }
    }
  }
}
