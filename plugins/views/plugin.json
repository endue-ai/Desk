{
  "id": "desk.views",
  "name": "Views",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "The view engine: opens a view file, binds its requires to connected sources, and draws its items, live, with the desk's elements.",
  "permissions": [
    { "permission": "data:read" },
    { "permission": "connector:manage" },
    { "permission": "view:manage" },
    { "permission": "cmd:invoke", "ids": ["*"] },
    { "permission": "shell:open", "schemes": ["http", "https", "mailto"] }
  ],
  "surfaces": [{ "id": "main", "title": "Views", "placement": "overlay", "hidden": true }],
  "contributes": {
    "commands": [
      {
        "id": "desk.views.open",
        "title": "Open a view",
        "keywords": ["view", "dashboard", "today"],
        "description": "Open a saved view or page by id with optional params. Use desk.views.list to find saved views. Agent calls use id and params.",
        "args": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "params": { "type": "object" },
            "bindings": { "type": "object" },
            "view": { "type": "object" },
            "preview": { "type": "object" },
            "notice": { "type": "object" },
            "owner": {}
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "desk.views.list",
        "title": "List saved views",
        "keywords": ["views", "pages", "saved", "list"],
        "description": "List the IDs, titles and kinds of the saved views and pages.",
        "args": { "type": "object", "properties": {}, "additionalProperties": false },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "desk.views.read",
        "title": "Read the item sections of a saved view",
        "keywords": ["view", "page", "today", "items", "read"],
        "description": "Read the item-source sections of a saved view or page by id with optional params. Returns their entries and any unavailable section states without opening the view.",
        "args": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "params": { "type": "object" }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "desk.views.preview",
        "title": "Preview a proposed view",
        "keywords": ["view", "preview", "eris"]
      },
      { "id": "desk.views.close", "title": "Close the view" },
      {
        "id": "desk.views.reconnect",
        "title": "Reconnect a source",
        "keywords": ["sync", "connector"]
      },
      {
        "id": "desk.views.request-access",
        "title": "Ask for access to items",
        "keywords": ["permission", "data"]
      },
      {
        "id": "desk.views.open-original",
        "title": "Open in the original app",
        "keywords": ["deep link", "source"]
      }
    ]
  }
}
