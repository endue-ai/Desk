{
  "id": "endue.chat-digest",
  "name": "Chat digest",
  "version": "0.1.0",
  "kind": "view",
  "description": "Every chat at a glance: what is unread, who mentioned you, the direct messages waiting and the latest across every service, as a page of universal views.",
  "view": {
    "id": "endue.chat-digest",
    "title": "Chats at a glance",
    "description": "Unread chat messages, mentions and direct messages waiting, and the latest messages across every chat service.",
    "columns": 3,
    "sections": [
      {
        "title": "Unread",
        "type": "stat",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "raw.channel",
                "op": "exists"
              },
              {
                "field": "unread",
                "op": "eq",
                "value": true
              }
            ],
            "limit": 500
          }
        },
        "empty": "All caught up."
      },
      {
        "title": "Mentions",
        "type": "stat",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "raw.channel",
                "op": "exists"
              },
              {
                "field": "unread",
                "op": "eq",
                "value": true
              },
              {
                "field": "raw.mentioned",
                "op": "eq",
                "value": true
              }
            ],
            "limit": 500
          }
        },
        "empty": "No one is waiting on you."
      },
      {
        "title": "Direct",
        "type": "stat",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "raw.channel",
                "op": "exists"
              },
              {
                "field": "unread",
                "op": "eq",
                "value": true
              },
              {
                "field": "raw.channelKind",
                "op": "in",
                "value": ["dm", "group"]
              }
            ],
            "limit": 500
          }
        },
        "empty": "No direct messages waiting."
      },
      {
        "title": "Mentions",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "raw.channel",
                "op": "exists"
              },
              {
                "field": "unread",
                "op": "eq",
                "value": true
              },
              {
                "field": "raw.mentioned",
                "op": "eq",
                "value": true
              }
            ],
            "sort": [
              {
                "field": "receivedAt",
                "dir": "desc"
              }
            ],
            "limit": 10
          }
        },
        "map": {
          "detail": "raw.channelName"
        },
        "actions": [
          {
            "command": "endue.chat.show",
            "title": "Open in Chat",
            "args": {
              "source": {
                "connector": "{source.connector}",
                "instance": "{source.instance}"
              },
              "id": "{id}"
            }
          },
          {
            "command": "endue.chat.reply",
            "title": "Reply in thread",
            "args": {
              "source": {
                "connector": "{source.connector}",
                "instance": "{source.instance}"
              },
              "id": "{id}"
            }
          }
        ],
        "empty": "No one is waiting on you."
      },
      {
        "title": "Direct messages",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "raw.channel",
                "op": "exists"
              },
              {
                "field": "unread",
                "op": "eq",
                "value": true
              },
              {
                "field": "raw.channelKind",
                "op": "in",
                "value": ["dm", "group"]
              }
            ],
            "sort": [
              {
                "field": "receivedAt",
                "dir": "desc"
              }
            ],
            "limit": 10
          }
        },
        "map": {
          "detail": "raw.workspace"
        },
        "actions": [
          {
            "command": "endue.chat.show",
            "title": "Open in Chat",
            "args": {
              "source": {
                "connector": "{source.connector}",
                "instance": "{source.instance}"
              },
              "id": "{id}"
            }
          }
        ],
        "empty": "No direct messages waiting."
      },
      {
        "title": "Latest across every chat",
        "type": "list",
        "source": {
          "items": {
            "kinds": ["message"],
            "where": [
              {
                "field": "raw.channel",
                "op": "exists"
              }
            ],
            "sort": [
              {
                "field": "receivedAt",
                "dir": "desc"
              }
            ],
            "limit": 25
          }
        },
        "map": {
          "detail": "raw.channelName"
        },
        "actions": [
          {
            "command": "endue.chat.show",
            "title": "Open in Chat",
            "args": {
              "source": {
                "connector": "{source.connector}",
                "instance": "{source.instance}"
              },
              "id": "{id}"
            }
          }
        ],
        "empty": "No chat messages yet. Connect Slack, Discord or another chat connector."
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "endue.chat-digest.open",
        "title": "Open the chat digest",
        "keywords": ["chat", "digest", "glance", "dashboard", "unread", "mentions"],
        "runs": {
          "command": "desk.views.open",
          "args": {
            "id": "endue.chat-digest"
          }
        }
      }
    ]
  }
}
