{
  "id": "desk.display",
  "name": "Display",
  "version": "0.1.0",
  "kind": "policy",
  "description": "Where new surfaces go, how big they are, and whether they take the focus.",
  "contributes": {
    "display": [
      {
        "match": {
          "placement": "overlay"
        },
        "area": "overlay",
        "focus": true
      },
      {
        "match": {
          "placement": "left"
        },
        "area": "left",
        "size": {
          "pixels": 240
        }
      },
      {
        "match": {
          "placement": "right"
        },
        "area": "right",
        "size": {
          "pixels": 320
        }
      },
      {
        "match": {
          "placement": "bottom"
        },
        "area": "bottom",
        "size": {
          "pixels": 72
        }
      },
      {
        "match": {
          "placement": "floating"
        },
        "area": "floating",
        "size": {
          "columns": 1,
          "rows": 1
        },
        "focus": true
      },
      {
        "match": {},
        "area": "center",
        "size": {
          "columns": 1,
          "rows": 1
        },
        "reuse": true,
        "focus": false
      }
    ],
    "settings": {
      "desk.display.unload-after": {
        "kind": "integer",
        "default": 300,
        "description": "Seconds a plugin window stays loaded once nothing shows it (another desktop, behind other windows); then its frame is unloaded and its state kept. 0 keeps it loaded."
      },
      "desk.display.live-surfaces": {
        "kind": "integer",
        "default": 24,
        "description": "How many plugin windows keep a live frame; past it the one hidden longest is unloaded at once. 0 sets no limit."
      }
    }
  }
}
