{
  "id": "endue.database",
  "name": "Database",
  "version": "0.2.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "description": "A client for PostgreSQL on the desk's own sessions, and MySQL / MariaDB and SQLite through their own command-line clients without a shell: connections, an explorer of every object kind with DDL and row counts, SQL consoles with highlighting, autocomplete, formatting and parameters, results that keep NULL apart with sorting, filtering, paging, a value viewer, a record view, copy and export, pending cell edits applied in one transaction, query plans, history and starred queries, and guards for read-only and production connections.",
  "permissions": [
    {
      "permission": "proc:spawn",
      "commands": ["mysql", "mariadb", "sqlite3"]
    },
    {
      "permission": "fs:write",
      "paths": ["${home}/Downloads/**"]
    },
    {
      "permission": "cmd:invoke",
      "ids": [
        "desk.palette.pick",
        "desk.buffers.open",
        "desk.buffers.update",
        "desk.buffers.close",
        "desk.files.reveal",
        "desk.files.changed"
      ]
    },
    { "permission": "fs:read", "paths": ["/**"] },
    { "permission": "proc:spawn", "commands": ["*"] },
    { "permission": "fs:write", "paths": ["/**"] },
    { "permission": "fs:read", "paths": ["${home}/.endue/database/**"] },
    { "permission": "fs:write", "paths": ["${home}/.endue/database/**"] },
    { "permission": "db:connect", "hosts": ["*"] }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Database",
      "placement": "center"
    }
  ],
  "contributes": {
    "files": [
      {
        "pattern": "*.sqlite",
        "plugin": "endue.database"
      },
      {
        "pattern": "*.sqlite3",
        "plugin": "endue.database"
      },
      {
        "pattern": "*.db3",
        "plugin": "endue.database"
      },
      {
        "pattern": "*.sql",
        "plugin": "endue.database"
      }
    ],
    "commands": [
      {
        "id": "endue.database.open",
        "title": "Database: open",
        "keywords": ["sql", "postgres", "mysql", "sqlite", "client"]
      },
      {
        "id": "endue.database.console",
        "title": "Database: open a console",
        "keywords": ["sql", "query"]
      },
      {
        "id": "endue.database.new-console",
        "title": "Database: new console",
        "keywords": ["sql", "query", "another", "tab", "second"]
      },
      {
        "id": "endue.database.consoles",
        "title": "Database: show a console",
        "keywords": ["consoles", "list", "switch", "sql"]
      },
      {
        "id": "endue.database.rename-console",
        "title": "Database: rename the console",
        "keywords": ["name", "title", "console"]
      },
      {
        "id": "endue.database.close-console",
        "title": "Database: close the console",
        "keywords": ["close", "console", "remove"]
      },
      {
        "id": "endue.database.run-file",
        "title": "Database: run a .sql file",
        "keywords": ["sql", "script", "file", "dump", "restore", "import"]
      },
      {
        "id": "endue.database.file-connection",
        "title": "Database: run this .sql file on another connection",
        "keywords": ["sql", "file", "connection", "bind"]
      },
      {
        "id": "endue.database.new-connection",
        "title": "Database: new connection",
        "keywords": ["add", "connect", "postgres", "mysql", "mariadb", "sqlite"]
      },
      {
        "id": "endue.database.import-uri",
        "title": "Database: new connection from a URI",
        "keywords": ["url", "dsn", "connection string"]
      },
      {
        "id": "endue.database.edit-connection",
        "title": "Database: change a connection",
        "keywords": ["edit"]
      },
      {
        "id": "endue.database.duplicate-connection",
        "title": "Database: duplicate a connection",
        "keywords": ["copy", "clone"]
      },
      {
        "id": "endue.database.remove-connection",
        "title": "Database: remove a connection",
        "keywords": ["delete", "forget"]
      },
      {
        "id": "endue.database.test-connection",
        "title": "Database: test a connection",
        "keywords": ["ping", "version"]
      },
      {
        "id": "endue.database.disconnect",
        "title": "Database: disconnect",
        "keywords": ["forget password", "sign out"]
      },
      {
        "id": "endue.database.copy-uri",
        "title": "Database: copy the connection URI",
        "keywords": ["url", "dsn"]
      },
      {
        "id": "endue.database.run",
        "title": "Database: run the statement",
        "keywords": ["execute", "query", "selection"]
      },
      {
        "id": "endue.database.run-all",
        "title": "Database: run the script",
        "keywords": ["execute", "all"]
      },
      {
        "id": "endue.database.run-transaction",
        "title": "Database: run the script in one transaction",
        "keywords": ["atomic", "begin", "commit"]
      },
      {
        "id": "endue.database.dry-run",
        "title": "Database: dry run (roll back at the end)",
        "keywords": ["rollback", "preview", "test"]
      },
      {
        "id": "endue.database.explain",
        "title": "Database: explain the statement",
        "keywords": ["plan", "query plan"]
      },
      {
        "id": "endue.database.explain-analyze",
        "title": "Database: explain analyze the statement",
        "keywords": ["plan", "timing", "actual"]
      },
      {
        "id": "endue.database.explain-options",
        "title": "Database: explain with options",
        "keywords": ["plan", "analyze", "buffers", "verbose", "settings", "wal", "generic plan"]
      },
      {
        "id": "endue.database.plan-view",
        "title": "Database: show the plan as a tree, flame or table",
        "keywords": ["query plan", "flame graph", "icicle", "where the time goes"]
      },
      {
        "id": "endue.database.copy-plan",
        "title": "Database: copy the query plan",
        "keywords": ["plan", "explain", "text", "json"]
      },
      {
        "id": "endue.database.compare-plans",
        "title": "Database: compare two query plans",
        "keywords": ["plan", "diff", "before and after", "regression"]
      },
      {
        "id": "endue.database.format",
        "title": "Database: format the SQL",
        "keywords": ["pretty", "beautify", "indent"]
      },
      {
        "id": "endue.database.cancel",
        "title": "Database: cancel the run",
        "keywords": ["stop", "kill", "interrupt"]
      },
      {
        "id": "endue.database.more",
        "title": "Database: load more rows",
        "keywords": ["fetch", "page"]
      },
      {
        "id": "endue.database.next-page",
        "title": "Database: next page of rows",
        "keywords": ["paging", "offset"]
      },
      {
        "id": "endue.database.previous-page",
        "title": "Database: previous page of rows",
        "keywords": ["paging", "offset"]
      },
      {
        "id": "endue.database.open-table",
        "title": "Database: open a table's rows",
        "keywords": ["data", "browse"]
      },
      {
        "id": "endue.database.refresh",
        "title": "Database: refresh the explorer",
        "keywords": ["reload", "schema"]
      },
      {
        "id": "endue.database.reload-schema",
        "title": "Database: read the schema again",
        "keywords": ["schema", "cache", "reload", "refresh", "catalog"]
      },
      {
        "id": "endue.database.choose-schemas",
        "title": "Database: choose the schemas to read",
        "keywords": ["schema", "cache", "system schemas", "catalog"]
      },
      {
        "id": "endue.database.filter-explorer",
        "title": "Database: filter the explorer",
        "keywords": ["find", "search", "objects"]
      },
      {
        "id": "endue.database.ddl",
        "title": "Database: show an object's DDL",
        "keywords": ["create", "definition", "source"]
      },
      {
        "id": "endue.database.er-diagram",
        "title": "Database: ER diagram of a schema",
        "keywords": ["entity relationship", "foreign keys", "relations", "erd"]
      },
      {
        "id": "endue.database.activity",
        "title": "Database: server activity (sessions and locks)",
        "keywords": [
          "sessions",
          "locks",
          "blocking",
          "waiting",
          "pg_stat_activity",
          "pg_locks",
          "processes",
          "stuck"
        ],
        "description": "Opens a PostgreSQL connection's sessions and locks and answers them: each session's process id, user, database, application, client, state, wait, ages and statement, and who waits for whom on which lock.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.database.activity-refresh",
        "title": "Database: refresh the server activity",
        "keywords": ["reload", "sessions", "locks"]
      },
      {
        "id": "endue.database.cancel-session",
        "title": "Database: cancel a session's statement",
        "keywords": ["pg_cancel_backend", "stop", "interrupt", "query", "kill"],
        "description": "Cancels the statement a PostgreSQL session runs (pg_cancel_backend); the session stays. The person is asked first, with the statement shown; a read-only connection refuses.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "description": "The session's process id (pid); the one selected in the panel, or one picked, when absent."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.database.end-session",
        "title": "Database: end a session",
        "keywords": ["pg_terminate_backend", "terminate", "kill", "disconnect", "backend"],
        "description": "Ends a PostgreSQL session (pg_terminate_backend): its connection closes and its open transaction rolls back. The person is asked first, with its statement shown; a read-only connection refuses.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "description": "The session's process id (pid); the one selected in the panel, or one picked, when absent."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.database.history",
        "title": "Database: history",
        "keywords": ["recent", "earlier queries"]
      },
      {
        "id": "endue.database.star",
        "title": "Database: star the query",
        "keywords": ["save", "favorite", "bookmark"]
      },
      {
        "id": "endue.database.starred",
        "title": "Database: starred queries",
        "keywords": ["saved", "favorites", "bookmarks"]
      },
      {
        "id": "endue.database.unstar",
        "title": "Database: unstar a query",
        "keywords": ["remove saved", "forget"]
      },
      {
        "id": "endue.database.copy",
        "title": "Database: copy the result as",
        "keywords": ["csv", "tsv", "json", "markdown", "insert", "update", "clipboard"]
      },
      {
        "id": "endue.database.export",
        "title": "Database: export the result to a file",
        "keywords": ["download", "save", "csv", "json", "sql"]
      },
      {
        "id": "endue.database.add-row",
        "title": "Database: add a row",
        "keywords": ["insert", "new row", "edit"]
      },
      {
        "id": "endue.database.preview-changes",
        "title": "Database: preview the pending changes",
        "keywords": ["diff", "sql", "edit"]
      },
      {
        "id": "endue.database.submit-changes",
        "title": "Database: submit the pending changes",
        "keywords": ["commit", "apply", "save", "edit"]
      },
      {
        "id": "endue.database.revert-changes",
        "title": "Database: revert the pending changes",
        "keywords": ["undo", "discard", "edit"]
      },
      {
        "id": "endue.database.set-default",
        "title": "Database: set the cell to DEFAULT",
        "keywords": ["default value", "edit", "cell", "reset"]
      },
      {
        "id": "endue.database.cell-file-load",
        "title": "Database: load the cell's bytes from a file",
        "keywords": ["bytea", "blob", "binary", "upload", "edit", "cell"]
      },
      {
        "id": "endue.database.cell-file-save",
        "title": "Database: save the cell's bytes to a file",
        "keywords": ["bytea", "blob", "binary", "download", "cell"]
      },
      {
        "id": "endue.database.clients",
        "title": "Database: check the clients",
        "keywords": ["postgresql", "mysql", "mariadb", "sqlite3", "install", "version"]
      }
    ],
    "keys": [
      {
        "key": "Mod+Shift+B",
        "command": "endue.database.open"
      }
    ],
    "settings": {
      "endue.database.max-rows": {
        "kind": "integer",
        "default": 500,
        "description": "Rows a result keeps (1 to 100000); More rows loads four times as many."
      },
      "endue.database.timeout-seconds": {
        "kind": "integer",
        "default": 0,
        "description": "Stop a run that takes longer, in seconds; 0 waits as long as it takes. PostgreSQL ends the statement on the server (statement_timeout)."
      },
      "endue.database.confirm": {
        "kind": "boolean",
        "default": true,
        "description": "Ask before statements that change a production connection, and before DROP, TRUNCATE, or UPDATE and DELETE without WHERE anywhere. Agents' writes are always asked."
      },
      "endue.database.history": {
        "kind": "boolean",
        "default": true,
        "description": "Keep the statements each connection ran (never their results, never statements that carry a password)."
      },
      "endue.database.history-max": {
        "kind": "integer",
        "default": 200,
        "description": "How many statements each connection's history keeps (0 to 1000)."
      },
      "endue.database.system-schemas": {
        "kind": "boolean",
        "default": false,
        "description": "Show the system schemas in the explorer (pg_catalog, information_schema, mysql, sys ...)."
      },
      "endue.database.mysql": {
        "kind": "string",
        "default": "",
        "description": "The MySQL client: a name on PATH or a full path. Empty: mysql, else mariadb. Any other program or path is asked for at its first run."
      },
      "endue.database.sqlite3": {
        "kind": "string",
        "default": "",
        "description": "The sqlite3 program: a name on PATH or a full path. Empty: sqlite3. Any other program or path is asked for at its first run."
      },
      "endue.database.path": {
        "kind": "array",
        "default": [],
        "description": "Folders searched for the clients when they are not on the desk's PATH, before Homebrew's and the system's."
      }
    }
  }
}
