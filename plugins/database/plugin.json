      },
      {
        "id": "endue.database.refresh",
        "title": "Database: refresh the explorer",
        "keywords": ["reload", "schema"]
      },
      {
        "id": "endue.database.reload-schema",
        "title": "Database: read the schema again",
        "keywords": ["schema", "cache", "reload", "refresh", "catalog"]
      },
      {
        "id": "endue.database.choose-schemas",
        "title": "Database: choose the schemas to read",
        "keywords": ["schema", "cache", "system schemas", "catalog"]
      },
      {
        "id": "endue.database.filter-explorer",
        "title": "Database: filter the explorer",
        "keywords": ["find", "search", "objects"]
      },
      {
        "id": "endue.database.ddl",
        "title": "Database: show an object's DDL",
        "keywords": ["create", "definition", "source"]
      },
      {
        "id": "endue.database.er-diagram",
        "title": "Database: ER diagram of a schema",
        "keywords": ["entity relationship", "foreign keys", "relations", "erd"]
      },
      {
        "id": "endue.database.activity",
        "title": "Database: server activity (sessions and locks)",
        "keywords": [
          "sessions",
          "locks",
          "blocking",
          "waiting",
          "pg_stat_activity",
          "pg_locks",
          "processes",
          "stuck"
        ],
        "description": "Opens a PostgreSQL connection's sessions and locks and answers them: each session's process id, user, database, application, client, state, wait, ages and statement, and who waits for whom on which lock.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.database.activity-refresh",
        "title": "Database: refresh the server activity",
        "keywords": ["reload", "sessions", "locks"]
      },
      {
        "id": "endue.database.cancel-session",
        "title": "Database: cancel a session's statement",
        "keywords": ["pg_cancel_backend", "stop", "interrupt", "query", "kill"],
        "description": "Cancels the statement a PostgreSQL session runs (pg_cancel_backend); the session stays. The person is asked first, with the statement shown; a read-only connection refuses.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "description": "The session's process id (pid); the one selected in the panel, or one picked, when absent."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.database.end-session",
        "title": "Database: end a session",
        "keywords": ["pg_terminate_backend", "terminate", "kill", "disconnect", "backend"],
        "description": "Ends a PostgreSQL session (pg_terminate_backend): its connection closes and its open transaction rolls back. The person is asked first, with its statement shown; a read-only connection refuses.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "description": "The session's process id (pid); the one selected in the panel, or one picked, when absent."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.database.search-data",
        "title": "Database: search for a value in tables",
        "keywords": [
          "find",
          "where is",
          "value",
          "id",
          "across tables",
          "grep",
          "lookup",
          "regex",
          "json"
        ],
        "description": "Looks for a value in every table of the chosen schemas, one table at a time in a read-only transaction with a statement timeout each, and answers the tables and columns that hold it with their counts and the first rows' keys. A production connection asks first. Without a value it opens the form.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            },
            "value": {
              "type": "string",
              "description": "The text or number to find; absent or empty opens the form."
            },
            "match": {
              "type": "string",
              "enum": ["equals", "contains", "starts", "regex"],
              "description": "How a value matches: equals (the default), contains, starts with, or a regular expression (PostgreSQL ~, MySQL and SQLite REGEXP)."
            },
            "ignoreCase": { "type": "boolean", "description": "Match ignoring case." },
            "schemas": {
              "type": "array",
              "items": { "type": "string" },
              "description": "The schemas to search; every one the explorer lists when absent."
            },
            "tables": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Only these tables (name or schema.name, * for any run of characters); every table when absent."
            },
            "types": {
              "type": "array",
              "items": { "type": "string", "enum": ["text", "number", "uuid", "json", "date"] },
              "description": "The kinds of column to look in; all five when absent."
            },
            "rowLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Matching rows read per table (100 when absent)."
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "description": "Seconds each table's statement may take (10 when absent)."
            },
            "sizeLimit": {
              "type": "integer",
              "minimum": 1,
              "description": "Tables estimated past this many rows are left out (1,000,000 when absent)."
            },
            "big": {
              "type": "boolean",
              "description": "Search the tables past the size limit too."
            }
          },
          "additionalProperties": false
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.database.search-data-cancel",
        "title": "Database: cancel the value search",
        "keywords": ["stop", "search", "find"]
      },
      {
        "id": "endue.database.overview",
        "title": "Database: server overview",
        "keywords": [
          "health",
          "statistics",
          "sizes",
          "unused indexes",
          "vacuum",
          "replication",
          "pg_stat_statements"
        ]
      },
      {
        "id": "endue.database.refresh-overview",
        "title": "Database: refresh the server overview",
        "keywords": ["reload", "statistics", "health"]
      },
      {
        "id": "endue.database.overview-result",
        "title": "Database: open an overview section in the console",
        "keywords": ["result", "copy", "export", "statistics"]
      },
      {
        "id": "endue.database.overview-statement",
        "title": "Database: open a heavy statement in the console",
        "keywords": ["pg_stat_statements", "slow query", "top queries"]
      },
      {
        "id": "endue.database.maintenance",
        "title": "Database: maintenance (VACUUM, ANALYZE, REINDEX, CLUSTER)",
        "keywords": [
          "vacuum",
          "analyze",
          "reindex",
          "cluster",
          "vacuum full",
          "bloat",
          "dead tuples",
          "statistics",
          "freeze",
          "locks"
        ],
        "description": "Opens the maintenance form of a PostgreSQL table, index, schema or database and answers the statement it runs, in words what it locks and for how long, and the target's size and statistics. With run, it runs the statement alone, outside a transaction block, after the person says yes, and answers how it ended, the server's output and the statistics before and after. A read-only connection refuses.",
        "args": {
          "type": "object",
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1,
              "description": "A connection's name or id; the one on screen, or one picked, when absent."
            },
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The schema; with neither table nor index, the whole schema. Without schema, the connection's whole database when connection is named; with neither, the table on screen or one picked from the palette."
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "description": "A table or materialized view of the schema."
            },
            "index": {
              "type": "string",
              "minLength": 1,
              "description": "An index of the schema, for REINDEX INDEX or CLUSTER of its table by it."
            },
            "operation": {
              "type": "string",
              "enum": ["vacuum", "analyze", "reindex", "cluster"],
              "description": "What to run; VACUUM by default (REINDEX for an index)."
            },
            "options": {
              "type": "object",
              "description": "The statement's options, on the defaults (an open form's own are set aside); what the server's version or another option rules out is left out of the statement.",
              "properties": {
                "full": { "type": "boolean" },
                "freeze": { "type": "boolean" },
                "verbose": { "type": "boolean", "description": "On by default." },
                "analyze": { "type": "boolean" },
                "skipLocked": { "type": "boolean" },
                "indexCleanup": { "type": "string", "enum": ["", "auto", "on", "off"] },
                "truncate": { "type": "string", "enum": ["", "on", "off"] },
                "parallel": { "type": ["integer", "null"], "minimum": 0, "maximum": 1024 },
                "processToast": { "type": "boolean" },
                "bufferUsageLimit": {
                  "type": "string",
                  "description": "A size such as 256kB or 16MB, or 0."
                },
                "concurrently": {
                  "type": "boolean",
                  "description": "REINDEX CONCURRENTLY; on by default."
                },
                "tablespace": {
                  "type": "string",
                  "description": "REINDEX's TABLESPACE, PostgreSQL 14 and later."
                },
                "using": {
                  "type": "string",
                  "description": "The index CLUSTER orders the table by."
                }
              },
              "additionalProperties": false
            },
            "run": {
              "type": "boolean",
              "description": "Run it once the form is open; the person is always asked first."
            }
          },
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.database.maintenance-run",
        "title": "Database: run the maintenance form",
        "keywords": ["vacuum", "analyze", "reindex", "cluster", "start", "execute"]
      },
      {
        "id": "endue.database.maintenance-cancel",
        "title": "Database: cancel the maintenance run",
        "keywords": ["stop", "abort", "pg_cancel_backend", "vacuum", "reindex"]
      },
      {
        "id": "endue.database.maintenance-refresh",
        "title": "Database: read the maintenance target again",
        "keywords": ["reload", "size", "statistics", "dead tuples", "last vacuum"]
      },
      {
