    "keys": [
      {
        "key": "Mod+Shift+B",
        "command": "endue.database.open"
      }
    ],
    "settings": {
      "endue.database.max-rows": {
        "kind": "integer",
        "default": 500,
        "description": "Rows a result keeps (1 to 100000); More rows loads four times as many."
      },
      "endue.database.timeout-seconds": {
        "kind": "integer",
        "default": 0,
        "description": "Stop a run that takes longer, in seconds; 0 waits as long as it takes. PostgreSQL ends the statement on the server (statement_timeout)."
      },
      "endue.database.confirm": {
        "kind": "boolean",
        "default": true,
        "description": "Ask before statements that change a production connection, and before DROP, TRUNCATE, or UPDATE and DELETE without WHERE anywhere. Agents' writes are always asked."
      },
      "endue.database.history": {
        "kind": "boolean",
        "default": true,
        "description": "Keep the statements each connection ran (never their results, never statements that carry a password)."
      },
      "endue.database.history-max": {
        "kind": "integer",
        "default": 200,
        "description": "How many statements each connection's history keeps (0 to 1000)."
      },
      "endue.database.system-schemas": {
        "kind": "boolean",
        "default": false,
        "description": "Show the system schemas in the explorer (pg_catalog, information_schema, mysql, sys ...)."
      },
      "endue.database.psql": {
        "kind": "string",
        "default": "",
        "description": "The psql program: a name on PATH or a full path. Empty: psql. Any other program or path is asked for at its first run."
      },
      "endue.database.mysql": {
        "kind": "string",
        "default": "",
        "description": "The MySQL client: a name on PATH or a full path. Empty: mysql, else mariadb. Any other program or path is asked for at its first run."
      },
      "endue.database.sqlite3": {
        "kind": "string",
        "default": "",
        "description": "The sqlite3 program: a name on PATH or a full path. Empty: sqlite3. Any other program or path is asked for at its first run."
      },
      "endue.database.path": {
        "kind": "array",
        "default": [],
        "description": "Folders searched for the clients when they are not on the desk's PATH, before Homebrew's and the system's."
      },
      "endue.database.format-keyword-case": {
        "kind": "string",
        "default": "upper",
        "choices": ["upper", "lower", "preserve"],
        "description": "How Format SQL writes PostgreSQL's keywords: upper (SELECT, INT), lower (select, int) or preserve (as typed). Names, strings and quoted identifiers never change."
      },
      "endue.database.format-indent": {
        "kind": "integer",
        "default": 4,
        "minimum": 1,
        "maximum": 8,
        "description": "Spaces a level of PostgreSQL's Format SQL indents (1 to 8)."
      },
      "endue.database.format-line-width": {
        "kind": "integer",
        "default": 80,
        "minimum": 40,
        "maximum": 240,
        "description": "The width a line of PostgreSQL's Format SQL keeps to when it can (40 to 240); a longer name or string still goes on one line."
      },
      "endue.database.format-comma": {
        "kind": "string",
        "default": "last",
        "choices": ["last", "first"],
        "description": "Where a broken list's commas go in PostgreSQL's Format SQL: last (id, then name on the next line) or first (id, then , name)."
      },
      "endue.database.format-and-or": {
        "kind": "string",
        "default": "before",
        "choices": ["before", "after"],
        "description": "Where a broken condition's AND and OR go in PostgreSQL's Format SQL: before (a line starts AND b = 1) or after (a line ends a = 1 AND)."
      },
      "endue.database.format-joins": {
        "kind": "string",
        "default": "flat",
        "choices": ["flat", "indented"],
        "description": "How joins sit in PostgreSQL's Format SQL: flat (JOIN under FROM) or indented (JOIN one level in from FROM)."
      },
      "endue.database.format-one-line": {
        "kind": "string",
        "default": "clause",
        "choices": ["clause", "statement", "item"],
        "description": "What PostgreSQL's Format SQL keeps on one line when it fits: each clause (SELECT a, b then FROM t), the whole statement (SELECT a, b FROM t), or only each item (every list and condition broken one item a line)."
      },
      "endue.database.format-lists": {
        "kind": "string",
        "default": "indent",
        "choices": ["indent", "align"],
        "description": "Where a broken list goes in PostgreSQL's Format SQL: indent (on the lines under SELECT, one level in) or align (after SELECT, each item under the first)."
      },
      "endue.database.format-on-save": {
        "kind": "boolean",
        "default": false,
        "description": "Save lays a .sql file's console out with Format SQL before it writes the file, by the format of the file's connection; a file on no connection yet is written as typed."
      }
    }
  }
}
