{
  "format": "desk-plugin/1",
  "manifest": {
    "id": "market.week-ahead",
    "name": "Week ahead",
    "version": "1.0.0",
    "kind": "view",
    "description": "The next seven days: events as an agenda and the tasks due before the week ends.",
    "view": {
      "id": "market.week-ahead",
      "version": "1.0.0",
      "title": "Week ahead",
      "description": "Events this week and the tasks due by its end.",
      "requires": {
        "calendar": {
          "kinds": [
            "event"
          ],
          "title": "A calendar"
        },
        "tasks": {
          "kinds": [
            "task"
          ],
          "title": "A task list (optional)"
        }
      },
      "layout": {
        "type": "grid",
        "columns": 2,
        "children": [
          {
            "type": "agenda",
            "title": "This week",
            "range": "week",
            "binding": {
              "kinds": [
                "event"
              ],
              "sources": [
                "$calendar"
              ],
              "sort": [
                {
                  "field": "start",
                  "dir": "asc"
                }
              ]
            },
            "fields": [
              {
                "value": "{start|time} {title}"
              },
              {
                "value": "{location}"
              }
            ],
            "empty": "Nothing on the calendar this week."
          },
          {
            "type": "list",
            "title": "Due this week",
            "binding": {
              "kinds": [
                "task"
              ],
              "sources": [
                "$tasks"
              ],
              "where": [
                {
                  "field": "status",
                  "op": "eq",
                  "value": "open"
                }
              ],
              "sort": [
                {
                  "field": "due",
                  "dir": "asc"
                }
              ],
              "limit": 20
            },
            "fields": [
              {
                "value": "{title}"
              },
              {
                "label": "Due",
                "value": "{due|relative}"
              }
            ],
            "empty": "Nothing due."
          }
        ]
      }
    }
  },
  "files": {}
}
