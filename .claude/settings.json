{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git-identity/ensure.sh\"",
            "timeout": 20,
            "statusMessage": "Checking the commit identity (AGENTS.md, Boundaries)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for direct Playwright runs (ADR 0018)"
          }
        ]
      }
    ]
  }
}
