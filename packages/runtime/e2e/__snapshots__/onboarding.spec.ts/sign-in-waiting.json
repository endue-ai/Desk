        "display": "block",
        "visibility": "visible",
        "opacity": "1",
        "transform": "none",
        "filter": "none",
        "color": "rgb(242, 240, 245)"
      },
      "children": [
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Hello."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "I'm E. R. I. S."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Endue's Ridiculously Impressive Secretary."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Small, I know."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "But I'll take care of your whole desk."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "I'd rather talk than type."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "May I use your microphone?"
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Thanks. I'm listening."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "What should I call you?"
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Nice to meet you, Ada."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Let's make this desk yours, Ada."
        },
        {
          "tag": "p",
          "style": {
            "display": "block",
            "visibility": "visible",
            "opacity": "1",
            "transform": "none",
            "filter": "none",
            "color": "rgb(242, 240, 245)"
          },
          "text": "Sign in, and I'll remember you on every desk."
        }
