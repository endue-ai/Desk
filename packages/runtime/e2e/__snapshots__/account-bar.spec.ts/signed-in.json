{
 "tag": "section",
 "class": "popover account-popover",
 "role": "dialog",
 "aria-label": "User information",
 "data-popover": "account",
 "style": {
  "background": "rgb(42, 40, 36)",
  "border": "solid rgb(50, 48, 43)"
 },
 "children": [
  {
   "tag": "div",
   "class": "account-menu",
   "role": "menu",
   "aria-label": "User menu",
   "children": [
    {
     "tag": "button",
     "class": "menu-item account-row",
     "role": "menuitem",
     "aria-label": "Inbox · 2",
     "children": [
      {
       "tag": "svg",
       "icon": "inbox"
      },
      {
       "tag": "span",
       "class": "pop-text",
       "style": {
        "color": "rgb(243, 241, 236)"
       },
       "text": "Inbox"
      },
      {
       "tag": "span",
       "class": "badge",
       "style": {
        "background": "rgb(35, 33, 30)",
        "color": "rgb(179, 175, 165)",
        "border": "solid rgba(0, 0, 0, 0)"
       },
       "text": "2"
      }
     ]
    },
    {
     "tag": "button",
     "class": "menu-item account-row",
     "role": "menuitem",
     "aria-label": "Open settings",
     "children": [
      {
       "tag": "svg",
       "icon": "settings"
      },
      {
       "tag": "span",
       "class": "pop-text",
       "style": {
        "color": "rgb(243, 241, 236)"
       },
       "text": "Open settings"
      },
      {
       "tag": "span",
       "class": "pop-muted",
       "style": {
        "color": "rgb(179, 175, 165)"
       },
       "text": "⌘,"
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "class": "pop-divider",
   "role": "separator",
   "style": {
    "background": "rgb(50, 48, 43)",
    "color": "rgb(243, 241, 236)"
   }
  },
  {
   "tag": "div",
   "class": "account-identity",
   "children": [
    {
     "tag": "span",
     "class": "account-avatar",
     "style": {
      "background": "rgb(42, 40, 36)",
      "color": "rgb(243, 241, 236)"
     },
     "text": "A"
    },
    {
     "tag": "div",
     "children": [
      {
       "tag": "strong",
       "style": {
        "color": "rgb(243, 241, 236)"
       },
       "text": "Ada Lovelace"
      },
      {
       "tag": "small",
       "style": {
        "color": "rgb(179, 175, 165)"
       },
       "text": "ada@example.com"
      }
     ]
    }
   ]
  },
  {
   "tag": "div",
   "class": "pop-row",
   "style": {
    "color": "rgb(243, 241, 236)"
   },
   "text": "endue ID",
   "children": [
    {
     "tag": "span",
     "class": "pop-muted",
     "style": {
      "color": "rgb(179, 175, 165)"
     },
     "text": "Signed in"
    }
   ]
  },
  {
   "tag": "div",
   "class": "account-actions",
   "children": [
    {
     "tag": "button",
     "class": "btn btn-primary",
     "style": {
      "background": "rgb(243, 241, 236)",
      "color": "rgb(28, 26, 23)",
      "border": "solid rgb(243, 241, 236)"
     },
     "text": "Account settings"
    },
    {
     "tag": "button",
     "class": "btn btn-outline",
     "style": {
      "background": "rgb(53, 50, 45)",
      "color": "rgb(243, 241, 236)",
      "border": "solid rgb(53, 50, 45)"
     },
     "text": "Sign out"
    }
   ]
  },
  {
   "tag": "div",
   "class": "pop-row",
   "style": {
    "color": "rgb(243, 241, 236)"
   },
   "text": "Profile",
   "children": [
    {
     "tag": "span",
     "class": "pop-muted",
     "style": {
      "color": "rgb(179, 175, 165)"
     },
     "text": "Morning"
    }
   ]
  },
  {
   "tag": "div",
   "class": "pop-row",
   "style": {
    "color": "rgb(243, 241, 236)"
   },
   "text": "Space",
   "children": [
    {
     "tag": "span",
     "class": "pop-muted",
     "style": {
      "color": "rgb(179, 175, 165)"
     },
     "text": "Home"
    }
   ]
  }
 ]
}
