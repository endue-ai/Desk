     "text": "Morning"
    }
   ]
  },
  {
   "tag": "div",
   "class": "pop-row",
   "style": {
    "color": "rgb(242, 240, 245)"
   },
   "text": "Space",
   "children": [
    {
     "tag": "span",
     "class": "pop-muted",
     "style": {
      "color": "rgb(176, 173, 183)"
     },
     "text": "Home"
    }
   ]
  }
 ]
}
