{
  "target": "InitDocument",
  "description": "two MCP servers: one with args and environment variables passed by name, one with only its command",
  "instance": {
    "mcp": {
      "servers": {
        "github": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-github"],
          "env": ["GITHUB_PERSONAL_ACCESS_TOKEN"]
        },
        "notes": {
          "command": "/usr/local/bin/notes-mcp"
        }
      }
    }
  }
}
