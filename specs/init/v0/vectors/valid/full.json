{
  "target": "InitDocument",
  "description": "a setup that uses every key",
  "instance": {
    "version": 0,
    "profile": "focus",
    "plugins": {
      "disabled": ["endue.sidebar", "example.hello-ui"]
    },
    "settings": {
      "eris.voice": true,
      "motion.reduce": false,
      "captions.linger-seconds": 4,
      "theme": "dark",
      "eris.wake-words": ["eris", "hey eris"],
      "layout.left": {
        "width": 280
      }
    },
    "agents": {
      "ag_01JBZ8Q4MR0000000000000001": {
        "allow": [
          {
            "permission": "fs:write",
            "paths": ["~/Documents/Notes/**"]
          },
          {
            "permission": "cmd:invoke",
            "ids": ["notes.*"]
          }
        ]
      },
      "mira": {
        "allow": []
      }
    },
    "sync": {
      "enabled": true
    }
  }
}
