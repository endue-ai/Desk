{
  "target": "BridgeRequest",
  "description": "db.open presenting a client certificate whose key is encrypted",
  "instance": {
    "id": 21,
    "method": "db.open",
    "params": {
      "engine": "postgresql",
      "host": "db.example.test",
      "database": "shop",
      "user": "reader",
      "tls": {
        "mode": "verify-full",
        "cert": "-----BEGIN CERTIFICATE-----\nMIIB\n-----END CERTIFICATE-----\n",
        "key": "-----BEGIN ENCRYPTED PRIVATE KEY-----\nMIIB\n-----END ENCRYPTED PRIVATE KEY-----\n",
        "keyPassword": "fixture-passphrase"
      },
      "scope": {
        "permission": "db:connect",
        "hosts": ["db.example.test:5432"]
      }
    }
  }
}
