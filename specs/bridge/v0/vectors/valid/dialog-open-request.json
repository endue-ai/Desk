    "method": "dialog.open",
    "params": {
      "title": "Open a note",
      "startIn": "~/Notes",
      "filters": [
        { "name": "Markdown", "extensions": ["md"] },
        { "name": "Text", "extensions": ["txt"] }
      ]
    }
  }
}
