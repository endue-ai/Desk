{
  "target": "BridgeRequest",
  "description": "shell.open with reveal shows a downloaded file in the file manager under a path scope",
  "instance": {
    "id": 10,
    "method": "shell.open",
    "params": {
      "target": "~/Downloads/report 2026.pdf",
      "reveal": true,
      "scope": {
        "permission": "shell:open",
        "paths": ["~/Downloads/**"]
      }
    }
  }
}
