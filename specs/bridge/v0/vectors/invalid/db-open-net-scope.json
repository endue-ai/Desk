{
  "target": "BridgeRequest",
  "description": "db.open carries a db:connect scope, not net:connect",
  "instance": {
    "id": 21,
    "method": "db.open",
    "params": {
      "engine": "postgresql",
      "host": "db.example.test",
      "database": "shop",
      "user": "reader",
      "scope": {
        "permission": "net:connect",
        "hosts": ["db.example.test:5432"]
      }
    }
  }
}
