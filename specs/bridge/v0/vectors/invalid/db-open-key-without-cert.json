{
  "target": "BridgeRequest",
  "description": "a client key needs its certificate",
  "instance": {
    "id": 21,
    "method": "db.open",
    "params": {
      "engine": "postgresql",
      "host": "db.example.test",
      "database": "shop",
      "user": "reader",
      "tls": {
        "mode": "require",
        "key": "a private key in PEM, without its certificate"
      },
      "scope": {
        "permission": "db:connect",
        "hosts": ["db.example.test:5432"]
      }
    }
  }
}
