{
  "target": "BridgeRequest",
  "description": "the TLS mode is one of the five",
  "instance": {
    "id": 21,
    "method": "db.open",
    "params": {
      "engine": "postgresql",
      "host": "db.example.test",
      "database": "shop",
      "user": "reader",
      "tls": {
        "mode": "allow"
