{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endue.ai/specs/bridge/v0/ui.schema.json",
  "title": "Desk bridge v0: ui",
  "description": "Surfaces and notifications. Scoped by ui:surface and ui:notify.",
  "$defs": {
    "UiSurfaceOpenRequest": {
      "description": "Open one of the surfaces the caller's manifest declares; the runtime hears ui.surface.opened.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "ui.surface.open" },
        "params": { "$ref": "#/$defs/UiSurfaceOpenParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "UiSurfaceOpenParams": {
      "description": "Parameters of ui.surface.open.",
      "type": "object",
      "properties": {
        "surface": {
          "description": "A surface id from the manifest.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "placement": { "$ref": "../../plugin/v0/plugin.schema.json#/$defs/SurfacePlacement" },
        "title": { "type": "string" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/UiSurfacePermission" }
      },
      "required": ["surface", "scope"],
      "additionalProperties": false
    },
    "UiSurfaceOpenResult": {
      "description": "Result of ui.surface.open.",
      "type": "object",
      "properties": {
        "handle": { "description": "Names the open surface.", "type": "string", "minLength": 1 }
      },
      "required": ["handle"],
      "additionalProperties": false
    },
    "UiSurfaceCloseRequest": {
      "description": "Close a surface the caller opened; the runtime hears ui.surface.closed.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "ui.surface.close" },
        "params": { "$ref": "#/$defs/UiSurfaceCloseParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "UiSurfaceCloseParams": {
      "description": "Parameters of ui.surface.close.",
      "type": "object",
      "properties": {
        "handle": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/UiSurfacePermission" }
      },
      "required": ["handle", "scope"],
      "additionalProperties": false
    },
    "UiSurfaceCloseResult": {
      "description": "Result of ui.surface.close.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "UiNotifyRequest": {
      "description": "Show a notification.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "ui.notify" },
        "params": { "$ref": "#/$defs/UiNotifyParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "UiNotifyParams": {
      "description": "Parameters of ui.notify.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "level": { "$ref": "#/$defs/NotifyLevel" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/UiNotifyPermission" }
      },
      "required": ["title", "scope"],
      "additionalProperties": false
    },
    "NotifyLevel": {
      "description": "How a notification is presented; info by default.",
      "type": "string",
      "enum": ["info", "success", "warning", "error"]
    },
    "UiNotifyResult": {
      "description": "Result of ui.notify.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1 }
      },
      "required": ["notificationId"],
      "additionalProperties": false
    },
    "UiNotifiedEvent": {
      "description": "A caller's ui.notify passed its permission check; the runtime shows it as its notify policy says.",
      "type": "object",
      "properties": {
        "event": { "const": "ui.notified" },
        "data": { "$ref": "#/$defs/UiNotifiedData" }
      },
      "required": ["event", "data"],
      "additionalProperties": false
    },
    "UiNotifiedData": {
      "description": "Payload of ui.notified.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1 },
        "caller": { "description": "The plugin that asked.", "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "level": { "$ref": "#/$defs/NotifyLevel" }
      },
      "required": ["notificationId", "caller", "title", "level"],
      "additionalProperties": false
    },
    "UiSurfaceOpenedEvent": {
      "description": "A caller's ui.surface.open passed its checks; the runtime mounts the surface as its display policy says.",
      "type": "object",
      "properties": {
        "event": { "const": "ui.surface.opened" },
        "data": { "$ref": "#/$defs/UiSurfaceOpenedData" }
      },
      "required": ["event", "data"],
      "additionalProperties": false
    },
    "UiSurfaceOpenedData": {
      "description": "Payload of ui.surface.opened. placement and title are the call's, else the manifest's; title is absent when neither has one.",
      "type": "object",
      "properties": {
        "handle": { "description": "Names the open surface.", "type": "string", "minLength": 1 },
        "caller": { "description": "The plugin that opened it.", "type": "string", "minLength": 1 },
        "surface": {
          "description": "The surface id from the caller's manifest.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "placement": { "$ref": "../../plugin/v0/plugin.schema.json#/$defs/SurfacePlacement" },
        "title": { "type": "string" }
      },
      "required": ["handle", "caller", "surface", "placement"],
      "additionalProperties": false
    },
    "UiSurfaceClosedEvent": {
      "description": "A surface closed: its caller closed it, or the caller unloaded; the runtime unmounts it.",
      "type": "object",
      "properties": {
        "event": { "const": "ui.surface.closed" },
        "data": { "$ref": "#/$defs/UiSurfaceClosedData" }
      },
      "required": ["event", "data"],
      "additionalProperties": false
    },
    "UiSurfaceClosedData": {
      "description": "Payload of ui.surface.closed. Placement and title are what ui.surface.opened said.",
      "type": "object",
      "properties": {
        "handle": { "type": "string", "minLength": 1 },
        "caller": { "description": "The plugin that opened it.", "type": "string", "minLength": 1 },
        "surface": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      },
      "required": ["handle", "caller", "surface"],
      "additionalProperties": false
    }
  }
}
