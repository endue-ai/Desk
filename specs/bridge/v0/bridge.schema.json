{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endue.ai/specs/bridge/v0/bridge.schema.json",
  "title": "Desk bridge v0: envelope",
  "description": "Messages between the web runtime and the Rust core. Requests carry their permission scope; anything not granted is denied.",
  "$defs": {
    "RequestId": {
      "description": "Chosen by the caller, unique among its requests in flight. The response repeats it.",
      "type": "integer",
      "minimum": 0
    },
    "Path": {
      "description": "An absolute path, or one rooted at ~ or at ${plugin}, ${workspace} or ${home}, with forward slashes.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(/|~(/|$)|[A-Za-z]:/|\\$\\{(plugin|workspace|home)\\}(/|$))[^\\\\]*$"
    },
    "CallerId": {
      "description": "Who makes calls: a plugin id such as endue.eris, a name of the desk's own such as desk (the web runtime), agent:<id> for an agent of the brain whose tool call the core runs (ADR 0072), or mcp:<name> for an MCP server init.yaml lists (ADR 0098). core names desk-core itself.",
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*|agent:[A-Za-z0-9][A-Za-z0-9_.-]*|mcp:[a-z][a-z0-9-]{0,31})$",
      "maxLength": 128
    },
    "Encoding": {
      "description": "How binary-safe string content is encoded.",
      "type": "string",
      "enum": ["utf8", "base64"]
    },
    "BridgeRequest": {
      "description": "Any bridge call. The method field selects the params shape.",
      "oneOf": [
        { "$ref": "search.schema.json#/$defs/SearchReplaceRequest" },
        { "$ref": "search.schema.json#/$defs/SearchQueryRequest" },
        { "$ref": "search.schema.json#/$defs/SearchSystemRequest" },
        { "$ref": "search.schema.json#/$defs/SearchOpenRequest" },
        { "$ref": "fs.schema.json#/$defs/FsReadRequest" },
        { "$ref": "fs.schema.json#/$defs/FsWriteRequest" },
        { "$ref": "fs.schema.json#/$defs/FsListRequest" },
        { "$ref": "fs.schema.json#/$defs/FsWatchRequest" },
        { "$ref": "fs.schema.json#/$defs/FsUrlRequest" },
        { "$ref": "fs.schema.json#/$defs/FsHistoryRequest" },
        { "$ref": "fs.schema.json#/$defs/FsRestoreRequest" },
        { "$ref": "fs.schema.json#/$defs/FsStatRequest" },
        { "$ref": "fs.schema.json#/$defs/FsMkdirRequest" },
        { "$ref": "fs.schema.json#/$defs/FsRenameRequest" },
        { "$ref": "fs.schema.json#/$defs/FsCopyRequest" },
        { "$ref": "fs.schema.json#/$defs/FsTrashRequest" },
        { "$ref": "proc.schema.json#/$defs/ProcSpawnRequest" },
        { "$ref": "proc.schema.json#/$defs/ProcWriteRequest" },
        { "$ref": "proc.schema.json#/$defs/ProcResizeRequest" },
        { "$ref": "proc.schema.json#/$defs/ProcKillRequest" },
        { "$ref": "net.schema.json#/$defs/NetFetchRequest" },
        { "$ref": "net.schema.json#/$defs/NetConnectRequest" },
        { "$ref": "net.schema.json#/$defs/NetSendRequest" },
        { "$ref": "net.schema.json#/$defs/NetCloseRequest" },
        { "$ref": "audio.schema.json#/$defs/AudioCaptureStartRequest" },
        { "$ref": "audio.schema.json#/$defs/AudioCaptureStopRequest" },
        { "$ref": "ui.schema.json#/$defs/UiSurfaceOpenRequest" },
        { "$ref": "ui.schema.json#/$defs/UiSurfaceCloseRequest" },
        { "$ref": "ui.schema.json#/$defs/UiNotifyRequest" },
        { "$ref": "perm.schema.json#/$defs/PermRequestRequest" },
        { "$ref": "perm.schema.json#/$defs/PermQueryRequest" },
        { "$ref": "perm.schema.json#/$defs/PermRevokeRequest" },
        { "$ref": "perm.schema.json#/$defs/PermGrantRequest" },
        { "$ref": "perm.schema.json#/$defs/PermListRequest" },
        { "$ref": "perm.schema.json#/$defs/PermAnswerRequest" },
        { "$ref": "perm.schema.json#/$defs/PermApproveRequest" },
        { "$ref": "plugins.schema.json#/$defs/PluginListRequest" },
        { "$ref": "plugins.schema.json#/$defs/PluginSetEnabledRequest" },
        { "$ref": "plugins.schema.json#/$defs/PluginStatsRequest" },
        { "$ref": "market.schema.json#/$defs/MarketListRequest" },
        { "$ref": "market.schema.json#/$defs/PluginInstallRequest" },
        { "$ref": "market.schema.json#/$defs/PluginRemoveRequest" },
        { "$ref": "store.schema.json#/$defs/StoreGetRequest" },
        { "$ref": "store.schema.json#/$defs/StoreSetRequest" },
        { "$ref": "init.schema.json#/$defs/InitGetRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainSayRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainAskRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainAgentsListRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainAgentsCardRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainSpacesListRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainTasksListRequest" },
        { "$ref": "brain.schema.json#/$defs/BrainStatusRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdRegisterRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdUnregisterRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdListRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdInvokeRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdAnswerRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdToolsRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdRecentRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdUndoRequest" },
        { "$ref": "cmd.schema.json#/$defs/CmdRedoRequest" },
        { "$ref": "settings.schema.json#/$defs/SettingsGetRequest" },
        { "$ref": "settings.schema.json#/$defs/SettingsSetRequest" },
        { "$ref": "settings.schema.json#/$defs/SettingsListRequest" },
        { "$ref": "log.schema.json#/$defs/LogWriteRequest" },
        { "$ref": "log.schema.json#/$defs/LogTailRequest" },
        { "$ref": "events.schema.json#/$defs/EventsSubscribeRequest" },
        { "$ref": "events.schema.json#/$defs/EventsUnsubscribeRequest" },
        { "$ref": "data.schema.json#/$defs/DataQueryRequest" },
        { "$ref": "data.schema.json#/$defs/DataGetRequest" },
        { "$ref": "data.schema.json#/$defs/DataSubscribeRequest" },
        { "$ref": "data.schema.json#/$defs/DataUnsubscribeRequest" },
        { "$ref": "connector.schema.json#/$defs/ConnectorListRequest" },
        { "$ref": "connector.schema.json#/$defs/ConnectorConnectRequest" },
        { "$ref": "connector.schema.json#/$defs/ConnectorDisconnectRequest" },
        { "$ref": "connector.schema.json#/$defs/ConnectorSyncNowRequest" },
        { "$ref": "view.schema.json#/$defs/ViewListRequest" },
        { "$ref": "view.schema.json#/$defs/ViewGetRequest" },
        { "$ref": "view.schema.json#/$defs/ViewSaveRequest" },
        { "$ref": "view.schema.json#/$defs/ViewRemoveRequest" },
        { "$ref": "catalog.schema.json#/$defs/CatalogGetRequest" },
        { "$ref": "shell.schema.json#/$defs/ShellOpenRequest" },
        { "$ref": "update.schema.json#/$defs/UpdateStatusRequest" },
        { "$ref": "update.schema.json#/$defs/UpdateCheckRequest" },
        { "$ref": "update.schema.json#/$defs/UpdateDownloadRequest" },
        { "$ref": "update.schema.json#/$defs/UpdateApplyRequest" },
        { "$ref": "update.schema.json#/$defs/UpdateSetChannelRequest" },
        { "$ref": "account.schema.json#/$defs/AccountStatusRequest" },
        { "$ref": "account.schema.json#/$defs/AccountSignInRequest" },
        { "$ref": "account.schema.json#/$defs/AccountSignOutRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsListRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsSessionsRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsTranscriptRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsImportRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsAskRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsRunsRequest" },
        { "$ref": "agents.schema.json#/$defs/AgentsStopRequest" },
        { "$ref": "memory.schema.json#/$defs/MemoryListRequest" },
        { "$ref": "memory.schema.json#/$defs/MemoryGetRequest" },
        { "$ref": "memory.schema.json#/$defs/MemoryRememberRequest" },
        { "$ref": "memory.schema.json#/$defs/MemoryForgetRequest" },
        { "$ref": "memory.schema.json#/$defs/MemorySearchRequest" },
        { "$ref": "agent.schema.json#/$defs/AgentListRequest" },
        { "$ref": "agent.schema.json#/$defs/AgentCancelRequest" },
        { "$ref": "agent.schema.json#/$defs/AgentReportRequest" },
        { "$ref": "theme.schema.json#/$defs/ThemeSaveRequest" },
        { "$ref": "theme.schema.json#/$defs/ThemeImportRequest" },
        { "$ref": "theme.schema.json#/$defs/ThemeExportRequest" },
        { "$ref": "theme.schema.json#/$defs/ThemeRemoveRequest" },
        { "$ref": "theme.schema.json#/$defs/ThemeMarketListRequest" },
        { "$ref": "theme.schema.json#/$defs/ThemeMarketFetchRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsListRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsGetRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsCreateRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsUpdateRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsSetStatusRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsRemoveRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsFacetsRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioAgentsPromptUpdateRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioCatalogListRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioCatalogRecommendRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioCatalogUseRequest" },
        { "$ref": "studio.schema.json#/$defs/StudioConversationsListRequest" },
        { "$ref": "studio-spaces.schema.json#/$defs/StudioSpacesListRequest" },
        { "$ref": "studio-spaces.schema.json#/$defs/StudioSpacesGetRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerPermissionsStatusRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerPermissionsRequestRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerPermissionsOpenRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerScreenshotRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerWindowsRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAppsListRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAppsLaunchRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAppsActivateRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAppsQuitRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAxTreeRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAxFindRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerAxPerformRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerInputClickRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerInputMoveRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerInputDragRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerInputScrollRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerInputTypeRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerInputKeysRequest" },
        { "$ref": "computer.schema.json#/$defs/ComputerStopRequest" }
      ]
    },
    "BridgeResponse": {
      "description": "The answer to one request: a result, or an error.",
      "oneOf": [{ "$ref": "#/$defs/BridgeSuccess" }, { "$ref": "#/$defs/BridgeFailure" }]
    },
    "BridgeSuccess": {
      "description": "The call succeeded. result has the shape of the method's Result type.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/RequestId" },
        "ok": { "const": true },
        "result": { "description": "The method's result." }
      },
      "required": ["id", "ok", "result"],
      "additionalProperties": false
    },
    "BridgeFailure": {
      "description": "The call failed or was denied.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/RequestId" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/BridgeError" }
      },
      "required": ["id", "ok", "error"],
      "additionalProperties": false
    },
    "BridgeError": {
      "description": "Why a call failed. permission_denied names the permission that was missing.",
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "description": "For people; never parse it.", "type": "string" },
        "permission": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/Permission" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "ErrorCode": {
      "description": "Machine-readable failure reason. signed_out: the call needs the desk's endue ID and the desk is not signed in (or its sign-in ran out). offline: a service the call needs could not be reached, or did not answer in time. forbidden: that service refused the person (another person's agent, a plan that does not allow it); permission_denied is the desk's own refusal.",
      "type": "string",
      "enum": [
        "permission_denied",
        "invalid_params",
        "not_found",
        "already_exists",
        "io_error",
        "timeout",
        "cancelled",
        "unsupported",
        "invalid_value",
        "internal",
        "signed_out",
        "offline",
        "forbidden"
      ]
    },
    "BridgeEvent": {
      "description": "Something the core reports without being asked: file changes, process output, socket data, wake words, permission changes, prompts and approvals, notifications, surfaces, commands, settings, log entries, changes to items, connectors and views, the desk's update status, its endue ID account, runs to stop, the runs of the agent programs on this computer, and what is being done to the computer.",
      "oneOf": [
        { "$ref": "fs.schema.json#/$defs/FsChangedEvent" },
        { "$ref": "proc.schema.json#/$defs/ProcOutputEvent" },
        { "$ref": "proc.schema.json#/$defs/ProcExitEvent" },
        { "$ref": "net.schema.json#/$defs/NetDataEvent" },
        { "$ref": "net.schema.json#/$defs/NetClosedEvent" },
        { "$ref": "audio.schema.json#/$defs/AudioWakeEvent" },
        { "$ref": "perm.schema.json#/$defs/PermChangedEvent" },
        { "$ref": "perm.schema.json#/$defs/PermPromptEvent" },
        { "$ref": "perm.schema.json#/$defs/PermApprovalEvent" },
        { "$ref": "perm.schema.json#/$defs/PermApprovalDoneEvent" },
        { "$ref": "plugins.schema.json#/$defs/PluginChangedEvent" },
        { "$ref": "ui.schema.json#/$defs/UiNotifiedEvent" },
        { "$ref": "ui.schema.json#/$defs/UiSurfaceOpenedEvent" },
        { "$ref": "ui.schema.json#/$defs/UiSurfaceClosedEvent" },
        { "$ref": "brain.schema.json#/$defs/BrainTurnEvent" },
        { "$ref": "cmd.schema.json#/$defs/CmdChangedEvent" },
        { "$ref": "cmd.schema.json#/$defs/CmdInvokedEvent" },
        { "$ref": "cmd.schema.json#/$defs/CmdAnsweredEvent" },
        { "$ref": "cmd.schema.json#/$defs/CmdUndoneEvent" },
        { "$ref": "settings.schema.json#/$defs/SettingsChangedEvent" },
        { "$ref": "settings.schema.json#/$defs/SettingsInvalidEvent" },
        { "$ref": "log.schema.json#/$defs/LogEntryEvent" },
        { "$ref": "data.schema.json#/$defs/DataChangedEvent" },
        { "$ref": "connector.schema.json#/$defs/ConnectorChangedEvent" },
        { "$ref": "view.schema.json#/$defs/ViewChangedEvent" },
        { "$ref": "update.schema.json#/$defs/UpdateChangedEvent" },
        { "$ref": "account.schema.json#/$defs/AccountChangedEvent" },
        { "$ref": "agents.schema.json#/$defs/AgentsRunEvent" },
        { "$ref": "agents.schema.json#/$defs/AgentsChangedEvent" },
        { "$ref": "memory.schema.json#/$defs/MemoryChangedEvent" },
        { "$ref": "agent.schema.json#/$defs/AgentCancelledEvent" },
        { "$ref": "computer.schema.json#/$defs/ComputerActivityEvent" }
      ]
    }
  }
}
