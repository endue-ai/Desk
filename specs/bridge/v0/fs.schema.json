{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endue.ai/specs/bridge/v0/fs.schema.json",
  "title": "Desk bridge v0: fs",
  "description": "Files: read, write, list and watch. Scoped by fs:read or fs:write paths.",
  "$defs": {
    "FsReadRequest": {
      "description": "Read a whole file.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "fs.read" },
        "params": { "$ref": "#/$defs/FsReadParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "FsReadParams": {
      "description": "Parameters of fs.read.",
      "type": "object",
      "properties": {
        "path": { "$ref": "bridge.schema.json#/$defs/Path" },
        "encoding": { "$ref": "bridge.schema.json#/$defs/Encoding" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/FsReadPermission" }
      },
      "required": ["path", "scope"],
      "additionalProperties": false
    },
    "FsReadResult": {
      "description": "Result of fs.read.",
      "type": "object",
      "properties": {
        "content": { "description": "The file content.", "type": "string" },
        "encoding": { "$ref": "bridge.schema.json#/$defs/Encoding" }
      },
      "required": ["content", "encoding"],
      "additionalProperties": false
    },
    "FsWriteRequest": {
      "description": "Create or overwrite a file.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "fs.write" },
        "params": { "$ref": "#/$defs/FsWriteParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "FsWriteParams": {
      "description": "Parameters of fs.write.",
      "type": "object",
      "properties": {
        "path": { "$ref": "bridge.schema.json#/$defs/Path" },
        "content": { "description": "The new file content.", "type": "string" },
        "encoding": { "$ref": "bridge.schema.json#/$defs/Encoding" },
        "createDirs": { "description": "Create missing parent folders.", "type": "boolean" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/FsWritePermission" }
      },
      "required": ["path", "content", "scope"],
      "additionalProperties": false
    },
    "FsWriteResult": {
      "description": "Result of fs.write.",
      "type": "object",
      "properties": {
        "bytesWritten": { "description": "Bytes written to disk.", "type": "integer", "minimum": 0 }
      },
      "required": ["bytesWritten"],
      "additionalProperties": false
    },
    "FsListRequest": {
      "description": "List the entries of a folder.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "fs.list" },
        "params": { "$ref": "#/$defs/FsListParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "FsListParams": {
      "description": "Parameters of fs.list.",
      "type": "object",
      "properties": {
        "path": { "$ref": "bridge.schema.json#/$defs/Path" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/FsReadPermission" }
      },
      "required": ["path", "scope"],
      "additionalProperties": false
    },
    "FsListResult": {
      "description": "Result of fs.list.",
      "type": "object",
      "properties": {
        "entries": { "type": "array", "items": { "$ref": "#/$defs/DirEntry" } }
      },
      "required": ["entries"],
      "additionalProperties": false
    },
    "DirEntry": {
      "description": "One folder entry.",
      "type": "object",
      "properties": {
        "name": { "description": "File name without the folder.", "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/EntryKind" },
        "size": { "description": "Size in bytes, for files.", "type": "integer", "minimum": 0 }
      },
      "required": ["name", "kind"],
      "additionalProperties": false
    },
    "EntryKind": {
      "description": "What a folder entry is.",
      "type": "string",
      "enum": ["file", "dir", "symlink"]
    },
    "FsWatchRequest": {
      "description": "Report changes under a path as fs.changed events until the caller unloads.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "fs.watch" },
        "params": { "$ref": "#/$defs/FsWatchParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "FsWatchParams": {
      "description": "Parameters of fs.watch.",
      "type": "object",
      "properties": {
        "path": { "$ref": "bridge.schema.json#/$defs/Path" },
        "recursive": { "description": "Watch sub-folders too.", "type": "boolean" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/FsReadPermission" }
      },
      "required": ["path", "scope"],
      "additionalProperties": false
    },
    "FsWatchResult": {
      "description": "Result of fs.watch.",
      "type": "object",
      "properties": {
        "watchId": { "description": "Names the watch in fs.changed events.", "type": "string", "minLength": 1 }
      },
      "required": ["watchId"],
      "additionalProperties": false
    },
    "FsChangedEvent": {
      "description": "A watched path changed.",
      "type": "object",
      "properties": {
        "event": { "const": "fs.changed" },
        "data": { "$ref": "#/$defs/FsChangedData" }
      },
      "required": ["event", "data"],
      "additionalProperties": false
    },
    "FsChangedData": {
      "description": "Payload of fs.changed.",
      "type": "object",
      "properties": {
        "watchId": { "type": "string", "minLength": 1 },
        "path": { "$ref": "bridge.schema.json#/$defs/Path" },
        "change": { "$ref": "#/$defs/FsChange" }
      },
      "required": ["watchId", "path", "change"],
      "additionalProperties": false
    },
    "FsChange": {
      "description": "What happened to the path.",
      "type": "string",
      "enum": ["created", "modified", "removed"]
    }
  }
}
