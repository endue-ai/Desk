{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endue.ai/specs/bridge/v0/view.schema.json",
  "title": "Desk bridge v0: view",
  "description": "The views on this desk (ADR 0032): the person's, the YAML files in ~/.desk/views, which can be listed, read, saved and removed, and the enabled view plugins', which can be listed and read but neither saved nor removed. A person's file shadows a plugin's view of its id. A saved view is checked like one installed from a plugin. Every call needs view:manage.",
  "$defs": {
    "ViewSource": {
      "description": "Where a view comes from: plugin, an enabled view plugin's inline view or one of its view files, read-only; file, the person's file in ~/.desk/views.",
      "type": "string",
      "enum": ["plugin", "file"]
    },
    "ViewSummary": {
      "description": "A view as view.list returns it: where it comes from and, for a plugin's view, the plugin.",
      "type": "object",
      "properties": {
        "id": { "$ref": "../../view/v0/view.schema.json#/$defs/ViewId" },
        "version": { "$ref": "../../plugin/v0/plugin.schema.json#/$defs/Version" },
        "title": { "$ref": "../../view/v0/view.schema.json#/$defs/Template" },
        "description": { "type": "string" },
        "source": { "$ref": "#/$defs/ViewSource" },
        "plugin": { "$ref": "../../plugin/v0/plugin.schema.json#/$defs/PluginId" }
      },
      "required": ["id", "version", "title", "source"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "plugin" } } },
          "then": { "properties": { "plugin": true }, "required": ["plugin"] },
          "else": { "properties": { "plugin": false } }
        }
      ]
    },
    "ViewListRequest": {
      "description": "List the views: the person's and the enabled view plugins', one per id.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "view.list" },
        "params": { "$ref": "#/$defs/ViewListParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "ViewListParams": {
      "description": "Parameters of view.list.",
      "type": "object",
      "properties": {
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/ViewManagePermission" }
      },
      "required": ["scope"],
      "additionalProperties": false
    },
    "ViewListResult": {
      "description": "Result of view.list, by view id.",
      "type": "object",
      "properties": {
        "views": { "type": "array", "items": { "$ref": "#/$defs/ViewSummary" } }
      },
      "required": ["views"],
      "additionalProperties": false
    },
    "ViewGetRequest": {
      "description": "Read one view whole, the person's or a plugin's.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "view.get" },
        "params": { "$ref": "#/$defs/ViewGetParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "ViewGetParams": {
      "description": "Parameters of view.get.",
      "type": "object",
      "properties": {
        "id": { "$ref": "../../view/v0/view.schema.json#/$defs/ViewId" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/ViewManagePermission" }
      },
      "required": ["id", "scope"],
      "additionalProperties": false
    },
    "ViewGetResult": {
      "description": "Result of view.get: the view, where it comes from and, for a plugin's view, the plugin.",
      "type": "object",
      "properties": {
        "view": { "$ref": "../../view/v0/view.schema.json#/$defs/View" },
        "source": { "$ref": "#/$defs/ViewSource" },
        "plugin": { "$ref": "../../plugin/v0/plugin.schema.json#/$defs/PluginId" }
      },
      "required": ["view", "source"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "plugin" } } },
          "then": { "properties": { "plugin": true }, "required": ["plugin"] },
          "else": { "properties": { "plugin": false } }
        }
      ]
    },
    "ViewSaveRequest": {
      "description": "Save one of the person's views, new or replacing the one with its id. A plugin's view is not saved: an id an enabled view plugin provides is saved only over the person's file of that id.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "view.save" },
        "params": { "$ref": "#/$defs/ViewSaveParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "ViewSaveParams": {
      "description": "Parameters of view.save. The view must pass specs/view/v0 and its names must resolve.",
      "type": "object",
      "properties": {
        "view": { "$ref": "../../view/v0/view.schema.json#/$defs/View" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/ViewManagePermission" }
      },
      "required": ["view", "scope"],
      "additionalProperties": false
    },
    "ViewSaveResult": {
      "description": "Result of view.save.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ViewRemoveRequest": {
      "description": "Remove one of the person's views. A plugin's view is not removed.",
      "type": "object",
      "properties": {
        "id": { "$ref": "bridge.schema.json#/$defs/RequestId" },
        "method": { "const": "view.remove" },
        "params": { "$ref": "#/$defs/ViewRemoveParams" }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    "ViewRemoveParams": {
      "description": "Parameters of view.remove.",
      "type": "object",
      "properties": {
        "id": { "$ref": "../../view/v0/view.schema.json#/$defs/ViewId" },
        "scope": { "$ref": "../../plugin/v0/permission.schema.json#/$defs/ViewManagePermission" }
      },
      "required": ["id", "scope"],
      "additionalProperties": false
    },
    "ViewRemoveResult": {
      "description": "Result of view.remove.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ViewChangedEvent": {
      "description": "A view was saved or removed. Sent to callers that hold view:manage.",
      "type": "object",
      "properties": {
        "event": { "const": "view.changed" },
        "data": { "$ref": "#/$defs/ViewChangedData" }
      },
      "required": ["event", "data"],
      "additionalProperties": false
    },
    "ViewChangedData": {
      "description": "Payload of view.changed.",
      "type": "object",
      "properties": {
        "id": { "$ref": "../../view/v0/view.schema.json#/$defs/ViewId" },
        "change": { "$ref": "#/$defs/ViewChange" }
      },
      "required": ["id", "change"],
      "additionalProperties": false
    },
    "ViewChange": {
      "description": "What happened to the view.",
      "type": "string",
      "enum": ["saved", "removed"]
    }
  }
}
