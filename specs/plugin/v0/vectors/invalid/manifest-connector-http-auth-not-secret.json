{
  "target": "PluginManifest",
  "description": "http.auth names a setting that is not secret, so the token would be listed back",
  "instance": {
    "id": "desk.github",
    "name": "GitHub",
    "version": "0.1.0",
    "kind": "connector",
    "description": "Your GitHub work as tasks: the issues assigned to you, the pull requests waiting for your review and your own open pull requests.",
    "permissions": [{ "permission": "net:fetch", "hosts": ["api.github.com"] }],
    "contributes": {
      "commands": [
        {
          "id": "desk.github.connect",
          "title": "Connect GitHub",
          "keywords": ["github", "issues", "pull requests", "token"],
          "runs": { "command": "desk.connectors.open", "args": { "connector": "desk.github" } }
        }
      ]
    },
    "connector": {
      "binding": "http",
      "http": {
        "baseUrl": "https://api.github.com",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "auth": { "setting": "token" },
        "requests": [
          {
            "path": "/search/issues",
            "query": { "q": "is:open assignee:@me", "sort": "updated", "per_page": "100" },
            "items": "/items",
            "pagination": { "next": "link" },
            "maxPages": 10,
            "map": "issue"
          },
          {
            "path": "/search/issues",
            "query": {
              "q": "is:open is:pr review-requested:@me",
              "sort": "updated",
              "per_page": "100"
            },
            "items": "/items",
            "pagination": { "next": "link" },
            "maxPages": 10,
            "map": "issue"
          },
          {
            "path": "/search/issues",
            "query": { "q": "is:open is:pr author:@me", "sort": "updated", "per_page": "100" },
            "items": "/items",
            "pagination": { "next": "link" },
            "maxPages": 10,
            "map": "issue"
          }
        ],
        "maps": {
          "issue": {
            "kind": "task",
            "fields": {
              "id": "/node_id",
              "title": "/title",
              "status": { "pointer": "/state", "values": { "open": "open", "closed": "done" } },
              "updatedAt": "/updated_at",
              "createdAt": "/created_at",
              "completedAt": "/closed_at",
              "due": "/milestone/due_on",
              "project": { "pointer": "/repository_url", "after": "/repos/" },
              "deepLink": "/html_url",
              "body": "/body",
              "raw": ""
            }
          }
        }
      },
      "auth": { "kind": "token", "title": "Personal access token" },
      "resources": [{ "kind": "task" }],
      "sync": { "mode": "pull", "intervalSeconds": 900 },
      "instanceSettings": {
        "token": {
          "kind": "string",
          "title": "Personal access token",
          "description": "A token that reads your issues and pull requests: fine-grained with read access to Issues and Pull requests, or classic with repo. Desk keeps it on this computer and sends it only to api.github.com.",
          "required": true
        }
      }
    }
  }
}
