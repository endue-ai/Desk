{
  "target": "PluginContributes",
  "description": "a setting may bound its value, give it a pattern and name what it was called before",
  "instance": {
    "settings": {
      "example.reader.zoom": {
        "kind": "number",
        "default": 1,
        "minimum": 0.25,
        "maximum": 4.5
      },
      "example.notes.slug": {
        "kind": "string",
        "default": "notes",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "desk.theme.scheme": {
        "kind": "string",
        "default": "dark",
        "choices": [
          "system",
          "light",
          "dark"
        ],
        "renamed": [
          "desk.theme.mode",
          "desk.scheme"
        ]
      }
    }
  }
}
