{
  "target": "PluginContributes",
  "description": "a setting may bound its value, give it a pattern and name what it was called before",
  "instance": {
    "settings": {
      "desk.notify.history": {
        "kind": "integer",
        "default": 200,
        "minimum": 0,
        "maximum": 10000
      },
      "example.notes.slug": {
        "kind": "string",
        "default": "notes",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "desk.theme.scheme": {
        "kind": "string",
        "default": "dark",
        "choices": ["system", "light", "dark"],
        "renamed": ["desk.theme.mode", "desk.scheme"]
      }
    }
  }
}
