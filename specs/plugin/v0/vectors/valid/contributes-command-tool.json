{
  "target": "PluginContributes",
  "description": "a command Eris may call as a tool, with what it answers and its args",
  "instance": {
    "commands": [
      {
        "id": "example.notes.recent",
        "title": "Recent notes",
        "tool": {
          "description": "The newest notes: title, when each changed and its first line.",
          "args": {
            "type": "object",
            "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 20 } },
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
