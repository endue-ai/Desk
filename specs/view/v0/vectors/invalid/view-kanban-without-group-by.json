{
  "target": "View",
  "description": "a kanban needs groupBy for its columns",
  "instance": {
    "id": "desk.today",
    "version": "0.1.0",
    "title": "Today",
    "description": "Today's events and the open tasks, side by side.",
    "requires": {
      "calendar": {
        "kinds": ["event"],
        "title": "A calendar"
      },
      "tasks": {
        "kinds": ["task"],
        "title": "A task list"
      }
    },
    "layout": {
      "type": "kanban",
      "binding": {
        "kinds": ["task"],
        "sources": ["$tasks"]
      }
    }
  }
}
