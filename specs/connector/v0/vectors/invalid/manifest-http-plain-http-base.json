{
  "target": "ConnectorManifest",
  "description": "a base URL over plain http to another computer, where the token would travel unencrypted",
  "instance": {
    "binding": "http",
    "http": {
      "baseUrl": "http://tracker.example.com/api",
      "headers": { "Accept": "application/json" },
      "auth": { "setting": "apiKey", "header": "X-Api-Key", "prefix": "" },
      "requests": [
        {
          "path": "/tickets",
          "query": { "assignee": "me" },
          "items": "/data",
          "pagination": { "next": "body", "pointer": "/links/next" },
          "map": "ticket"
        }
      ],
      "maps": {
        "ticket": {
          "kind": "task",
          "fields": {
            "id": "/id",
            "title": "/summary",
            "status": {
              "pointer": "/done",
              "values": { "true": "done", "false": "open" },
              "default": "open"
            },
            "updatedAt": "/updated",
            "priority": { "const": 2 },
            "raw": ""
          }
        }
      }
    },
    "auth": { "kind": "token", "title": "API key" },
    "resources": [{ "kind": "task" }],
    "sync": { "mode": "pull", "intervalSeconds": 600 },
    "instanceSettings": {
      "apiKey": { "kind": "string", "title": "API key", "secret": true, "required": true }
    }
  }
}
