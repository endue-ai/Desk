{
  "target": "ConnectorManifest",
  "description": "a secret setting has no default",
  "instance": {
    "binding": "wasm",
    "auth": {
      "kind": "none"
    },
    "resources": [
      {
        "kind": "note"
      },
      {
        "kind": "file",
        "live": true
      }
    ],
    "sync": {
      "mode": "pull",
      "intervalSeconds": 300
    },
    "instanceSettings": {
      "apiKey": {
        "kind": "string",
        "title": "API key",
        "secret": true,
        "default": "sk-test"
      }
    }
  }
}
