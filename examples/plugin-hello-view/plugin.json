{
  "id": "example.hello-view",
  "name": "Hello view",
  "version": "0.1.0",
  "kind": "view",
  "description": "The smallest view plugin: the notes touched last, newest first, with a command that opens it.",
  "view": {
    "id": "example.hello-view",
    "title": "Hello view",
    "description": "The notes touched last, newest first.",
    "type": "list",
    "types": ["list", "timeline"],
    "source": {
      "items": {
        "kinds": ["note"],
        "sort": [
          {
            "field": "updatedAt",
            "dir": "desc"
          }
        ],
        "limit": 20
      }
    },
    "empty": "No notes yet."
  },
  "contributes": {
    "commands": [
      {
        "id": "example.hello-view.open",
        "title": "Open Hello view",
        "runs": {
          "command": "desk.views.open",
          "args": {
            "id": "example.hello-view"
          }
        }
      }
    ]
  }
}
