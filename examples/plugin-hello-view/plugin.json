{
  "id": "example.hello-view",
  "name": "Hello view",
  "version": "0.1.0",
  "kind": "view",
  "description": "The smallest view plugin: the notes touched last, newest first, with a command that opens it.",
  "view": {
    "id": "example.hello-view",
    "version": "0.1.0",
    "title": "Hello view",
    "description": "The notes touched last, newest first.",
    "requires": {
      "notes": {
        "kinds": ["note"],
        "title": "Notes"
      }
    },
    "layout": {
      "type": "list",
      "title": "Notes",
      "binding": {
        "kinds": ["note"],
        "sources": ["$notes"],
        "sort": [
          {
            "field": "updatedAt",
            "dir": "desc"
          }
        ],
        "limit": 20
      },
      "fields": [
        {
          "value": "{title}"
        },
        {
          "value": "{updatedAt|relative}"
        }
      ],
      "empty": "No notes yet."
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "example.hello-view.open",
        "title": "Open Hello view",
        "runs": {
          "command": "desk.views.open",
          "args": {
            "id": "example.hello-view"
          }
        }
      }
    ]
  }
}
