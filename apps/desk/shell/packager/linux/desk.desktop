[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=text/markdown;text/plain;text/csv;application/pdf;image/png;image/jpeg;image/gif;image/webp;audio/mpeg;video/mp4;application/zip;text/html;
