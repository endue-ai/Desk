<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "endue-desk-cef Helper": CEF's utility processes, and, while the desk runs with Chromium's sandbox
     off, its GPU process too (seen on macOS 26 with CEF 156), whose SwiftShader fallback compiles
     shaders into MAP_JIT memory. Chromium gives only its GPU helper this; the desk gives both. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
