<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "endue-desk-cef Helper (GPU)": SwiftShader, the software fallback for WebGL and WebGPU, compiles
     shaders into MAP_JIT memory, as Chromium's helper-gpu-entitlements.plist allows. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
