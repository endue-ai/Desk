<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The desk's own process under the hardened runtime (#46). Wasm logic plugins compile in it with
     wasmtime's Cranelift, which maps its code writable and then executable without MAP_JIT: that
     needs allow-unsigned-executable-memory. Eris's microphone (desk-sys, AVFoundation), the camera a
     web plugin asks for, and the calendars and reminders the views show (EventKit) each need their
     device or data entitlement, as Chromium's app-entitlements.plist has its own. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
