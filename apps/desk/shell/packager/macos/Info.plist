		<dict><key>CFBundleTypeName</key><string>PDF</string><key>CFBundleTypeRole</key><string>Viewer</string><key>LSHandlerRank</key><string>Alternate</string><key>CFBundleTypeExtensions</key><array><string>pdf</string></array><key>CFBundleTypeMIMETypes</key><array><string>application/pdf</string></array></dict>
