{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "endue Desk",
  "mainBinaryName": "endue-desk",
  "version": "0.0.0",
  "identifier": "ai.endue.desk",
  "build": {
    "beforeDevCommand": "pnpm --filter @endue-ai/plugin-sdk --filter @endue-ai/ui build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @endue-ai/plugin-sdk --filter @endue-ai/ui build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "endue Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-src 'self' data: blob: desk-plugin: http://desk-plugin.localhost; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
