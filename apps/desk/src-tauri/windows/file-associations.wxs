<?xml version="1.0" encoding="utf-8"?>
<?if $(sys.BUILDARCH)="x86"?>
  <?define DeskWin64 = "no" ?>
<?else?>
  <?define DeskWin64 = "yes" ?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <!-- MSI owns only these values. Removal leaves defaults, UserChoice and other apps intact. -->
      <Component Id="DeskFileAssociations" Guid="*" Win64="$(var.DeskWin64)">
        <RegistryValue Root="HKMU" Key="Software\Classes\ai.endue.desk.file" Type="string" Value="endue Desk document" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ai.endue.desk.file\DefaultIcon" Type="string" Value="&quot;[#Path]&quot;,0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\ai.endue.desk.file\shell\open\command" Type="string" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.csv\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsx\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pptx\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdf\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp3\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.mp4\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.zip\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.html\OpenWithProgids" Name="ai.endue.desk.file" Type="string" Value="" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
